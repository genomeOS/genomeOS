DATABASE_URL=postgresql+psycopg://genomeos:change-me@127.0.0.1:5432/genomeos
GENOMEOS_ENV=development
PANUKB_REGION_QUERY_ENABLED=false
PANUKB_REGION_MAX_ROWS=10000
GOOGLE_MAPS_TOKEN=replace-with-http-referrer-restricted-browser-key
# Atlas per-artifact web data (design 2026-10-07 §C.1.4). Empty means unset: the site reads
# same-origin /data/atlas/ (tests only). For local development use the bucket base
# (https://storage.googleapis.com/<bucket>/atlas/web/) or http://127.0.0.1:4323/ for a staging tree.
PUBLIC_ATLAS_DATA_BASE_URL=
