{
  "name": "genomeos-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:fallback": "node scripts/build-fallback.mjs",
    "build:e2e": "ATLAS_CATALOG_PATH=tests/fixtures/atlas/e2e/catalog.json PUBLIC_ATLAS_REQUEST_STALL_MS=120000 npm run build",
    "build:favicons": "node scripts/build-favicons.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "PUBLIC_ATLAS_DATA_BASE_URL=http://127.0.0.1:4323/ PUBLIC_GA_MEASUREMENT_ID=G-TEST123 npm run build:e2e && playwright test",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "serve:test": "serve dist -c ../serve.json -l tcp://127.0.0.1:${PLAYWRIGHT_PORT:-4322} --no-clipboard",
    "serve:atlas-data": "node scripts/serve-atlas-data.mjs --root tests/fixtures/atlas/e2e",
    "check:links": "node scripts/check-links.mjs",
    "capture": "node scripts/capture-homepage.mjs",
    "capture:atlas": "npm run build:e2e && node scripts/capture-atlas.mjs",
    "capture:atlas-mobile": "npm run build:e2e && ATLAS_CAPTURE_PROFILE=mobile node scripts/capture-atlas.mjs",
    "capture:fast-load": "npm run build && node scripts/capture-atlas-fast-load.mjs --phase after",
    "capture:gnomad": "npm run build && node scripts/capture-gnomad-evidence.mjs",
    "capture:progress": "npm run build && node scripts/capture-atlas-progress.mjs",
    "capture:studs": "npm run build:e2e && node scripts/capture-observation-studs.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/raleway": "5.3.0",
    "@noble/hashes": "2.4.0",
    "astro": "7.3.1",
    "cesium": "1.145.0",
    "h3-js": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "serve": "14.2.6",
    "typescript": "6.0.3",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.0"
  }
}
