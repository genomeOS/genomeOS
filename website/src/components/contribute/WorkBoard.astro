---
/**
 * "How work moves": GitHub's project board, drawn in its own dark UI (round 2 spec §4.3.4, §0.4,
 * §8; R2-8; #454). A mechanism plate around a Primer-dark mock: the board's real title and Board
 * tab, five columns (Discussion · Backlog · In progress · In review · Merge) with their status icons,
 * counts and short lines, the real cards pinned from the board (src/data/board-snapshot.json, by
 * scripts/pin-board.mjs), and one plainly labelled example card. Ready folds into Backlog (the picked
 * card lights up); Merge, the owner's name for the last column, shows the board's Done.
 *
 * Under the columns runs one floor where the astronaut story happens. Without a script or under
 * reduced motion the floor is the storyboard frame, one beat per column (board-layout.ts
 * `renderStoryboard`, placed by percentages so it fits every width); with motion allowed, board.ts
 * (imported when the board is a viewport away) measures the columns, draws the live floor in its
 * place and plays the 36 s story, then 8 s idle loops, with Pause and Replay (WCAG 2.2.2).
 *
 * The example card rests in Merge, merged; a hidden copy of it in Backlog, In progress and In review
 * reserves its space there, so it moves by transforms and nothing shifts. Counts and pull-request
 * statuses carry their other values `hidden` until the story needs them. The story is told in words
 * in a visually hidden list; every picture is aria-hidden. Type is Figtree at GitHub's sizes, never
 * under 13 px; colours are Primer dark's (canvas #0d1117, panels #161b22, borders #30363d).
 */
import snapshot from '../../data/board-snapshot.json';
import { avatar } from '../../graphics/astro/props';
import SceneControls from '../kit/SceneControls.astro';
import {
  COLUMNS,
  EXAMPLE,
  STORY_TEXT,
  cardMeta,
  columnOf,
  formatFetched,
  labelStyle,
  renderStoryboard,
  scopeIds,
  shownLabels,
  type ColumnKey,
  type Snapshot,
  type SnapshotItem,
} from './board-layout';

const board = snapshot as Snapshot;

// A pinned card the page cannot place is a stale snapshot: fail the build, never drop it.
const stray = board.items.filter((item) => columnOf(item.status) === null);
if (stray.length)
  throw new Error(
    `board-snapshot.json: no column shows ${stray.map((item) => `#${item.number} (${item.status})`).join(', ')}; refresh it with scripts/pin-board.mjs`,
  );

const cardsIn = (key: ColumnKey) =>
  board.items.filter((item) => columnOf(item.status) === key);
const colourOf = (name: string) =>
  board.items
    .flatMap((item) => item.labels)
    .find((label) => label.name === name)?.color ?? '#8B949E';
const exampleLabels = EXAMPLE.labels.map((name) => ({
  name,
  color: colourOf(name),
}));

/* Octicon-style marks, drawn for this mock (decorative: the words beside them carry the meaning). */
const svg = (inner: string, attrs = '') =>
  `<svg class="gh-i" viewBox="0 0 16 16" aria-hidden="true" focusable="false"${attrs}>${inner}</svg>`;
const ICON = {
  issue: svg(
    '<circle cx="8" cy="8" r="6.2" fill="none" stroke="#3fb950" stroke-width="1.5"/><circle cx="8" cy="8" r="1.4" fill="#3fb950"/>',
  ),
  closed: svg(
    '<circle cx="8" cy="8" r="6.2" fill="none" stroke="#a371f7" stroke-width="1.5"/><path d="M5.3 8.2L7.2 10L10.8 6.2" fill="none" stroke="#a371f7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  ),
  pr: svg(
    '<circle cx="4" cy="3.6" r="1.7"/><circle cx="4" cy="12.4" r="1.7"/><circle cx="12" cy="12.4" r="1.7"/><path d="M4 5.3V10.7M12 10.7V6.6Q12 4.3 9.7 4.3H7.4M8.9 2.8L7.4 4.3L8.9 5.8"/>',
    ' fill="none" stroke="#3fb950" stroke-width="1.4" stroke-linecap="round"',
  ),
  merged: svg(
    '<circle cx="4" cy="3.6" r="1.7"/><circle cx="4" cy="12.4" r="1.7"/><circle cx="12" cy="8" r="1.7"/><path d="M4 5.3V10.7M4 5.3Q4.6 8 10.3 8"/>',
    ' fill="none" stroke="#a371f7" stroke-width="1.4" stroke-linecap="round"',
  ),
  discussion: svg(
    '<path d="M1.8 2.5H10.2V8.5H5.5L3 10.6V8.5H1.8Z"/><path d="M12.2 5.5H14.2V11.5H13V13.4L10.6 11.5H6.8V10.5"/>',
    ' fill="none" stroke="#58a6ff" stroke-width="1.4" stroke-linejoin="round"',
  ),
  kebab: svg(
    '<circle cx="3.5" cy="8" r="1.2"/><circle cx="8" cy="8" r="1.2"/><circle cx="12.5" cy="8" r="1.2"/>',
    ' fill="#7d8590"',
  ),
  project: svg(
    '<rect x="1.5" y="2" width="13" height="12" rx="1.5" fill="none" stroke="#7d8590" stroke-width="1.3"/><path d="M5.5 2V14M10.5 2V14" stroke="#7d8590" stroke-width="1.3"/>',
  ),
};
const status = (colour: string, kind: 'dash' | 'half' | 'dot' | 'full') =>
  svg(
    `<circle cx="8" cy="8" r="6" fill="none" stroke="${colour}" stroke-width="1.6"${kind === 'dash' ? ' stroke-dasharray="2.4 2"' : ''}/>` +
      (kind === 'half'
        ? `<path d="M8 2A6 6 0 0 1 8 14Z" fill="${colour}"/>`
        : kind === 'dot'
          ? `<circle cx="8" cy="8" r="2.6" fill="${colour}"/>`
          : kind === 'full'
            ? `<circle cx="8" cy="8" r="3.6" fill="${colour}"/>`
            : ''),
  );
const COLUMN_ICON: Record<ColumnKey, string> = {
  discussion: ICON.discussion,
  backlog: status('#7d8590', 'dash'),
  progress: status('#d29922', 'half'),
  review: status('#3fb950', 'dot'),
  merge: status('#a371f7', 'full'),
};
const cardIcon = (item: SnapshotItem) =>
  item.kind === 'discussion'
    ? ICON.discussion
    : item.state === 'closed'
      ? ICON.closed
      : ICON.issue;
/** A helmet avatar in a GitHub circle; ids are unique per copy (the page holds four cards). */
const face = (cast: 'A3' | 'E1' | 'E2', copy: string) =>
  `<svg class="gh-av" viewBox="-11 -11 22 22" aria-hidden="true" focusable="false">${scopeIds(avatar(cast, 10, '#30363d', { id: `av-${copy}-${cast}` }))}</svg>`;

const fetched = formatFetched(board.fetched);
const storyboard = renderStoryboard();
/** Where the example card sits at rest: Merge. Columns with a slot hold a copy of it. */
const SLOTS: ColumnKey[] = ['backlog', 'progress', 'review', 'merge'];
const REST: ColumnKey = 'merge';
---

<figure
  class="kit-plate wb"
  data-graphic="work-board"
  data-kind="mechanism"
  data-motion-exception="board"
>
  <div class="kit-plate__bar kit-plate__bar--top wb-head" data-figure-chrome>
    <p class="wb-head__title">
      <Fragment set:html={ICON.project} />
      <span>{board.project.title}</span>
    </p>
    <SceneControls object="the board animation" replay />
  </div>

  <div
    class="gh"
    data-figure-stage
    role="group"
    aria-labelledby="how-work-moves-title"
    aria-describedby="wb-caption"
  >
    <ol class="visually-hidden wb-story">
      {STORY_TEXT.map(([, text]) => <li>{text}</li>)}
    </ol>
    <div class="gh-tabs">
      <span class="gh-tab">Board</span>
    </div>
    <div class="gh-scroll">
      <div class="gh-pan">
        <div class="gh-track">
          <div class="gh-cols">
            {
              COLUMNS.map((column) => {
                const cards = cardsIn(column.key);
                const here = column.key === REST ? 1 : 0;
                return (
                  <div class="gh-col" data-col={column.key}>
                    <div class="gh-col__head">
                      <Fragment set:html={COLUMN_ICON[column.key]} />
                      <span class="gh-col__name">{column.name}</span>
                      <span class="gh-count">
                        <span class="c-out" hidden={here === 1}>
                          {cards.length}
                        </span>
                        <span
                          class="c-in"
                          hidden={here === 0}
                          aria-hidden={here === 0 ? 'true' : undefined}
                        >
                          {cards.length + 1}
                        </span>
                      </span>
                      <span class="gh-col__kebab" set:html={ICON.kebab} />
                    </div>
                    <p class="gh-col__line">{column.line}</p>
                    <div class="gh-cards">
                      {cards.map((item) => {
                        const meta = cardMeta(item);
                        return (
                          <article class="gh-card">
                            <p class="gh-card__meta">
                              <Fragment set:html={cardIcon(item)} />
                              <span>
                                {meta.repo && (
                                  <>
                                    <span class="brand-name">
                                      {meta.repo}
                                    </span>{' '}
                                  </>
                                )}
                                {meta.text}
                              </span>
                            </p>
                            <p class="gh-card__title">{item.title}</p>
                            {shownLabels(item).length > 0 && (
                              <p class="gh-card__labels">
                                {shownLabels(item).map((label) => (
                                  <span
                                    class="gh-label"
                                    style={labelStyle(label.color)}
                                  >
                                    {label.name}
                                  </span>
                                ))}
                              </p>
                            )}
                            {column.key === 'backlog' && (
                              <span
                                class="gh-hover"
                                data-hover="real"
                                aria-hidden="true"
                              />
                            )}
                          </article>
                        );
                      })}
                      {SLOTS.includes(column.key) && (
                        <article
                          class:list={[
                            'gh-card',
                            'gh-card--example',
                            column.key === REST && 'ex-lit',
                          ]}
                          data-example={column.key === REST ? 'home' : 'slot'}
                          aria-hidden="true"
                        >
                          <p class="gh-card__meta">
                            <span class="ex-icon">
                              <Fragment set:html={ICON.issue} />
                              <span class="ex-merged" set:html={ICON.closed} />
                            </span>
                            <span>{EXAMPLE.meta}</span>
                            <span
                              class="ex-av"
                              set:html={face('A3', column.key)}
                            />
                          </p>
                          <p class="gh-card__title">{EXAMPLE.title}</p>
                          <p class="gh-card__labels">
                            {exampleLabels.map((label) => (
                              <span
                                class="gh-label"
                                style={labelStyle(label.color)}
                              >
                                {label.name}
                              </span>
                            ))}
                          </p>
                          <div class="ex-pr">
                            <span class="ex-pr-icon">
                              <Fragment set:html={ICON.pr} />
                              <span
                                class="ex-pr-merged"
                                set:html={ICON.merged}
                              />
                            </span>
                            <span class="ex-st">
                              <span class="st st-req" hidden>
                                <i />
                                Review requested
                              </span>
                              <span class="st st-ok" hidden>
                                <i />
                                Approved
                              </span>
                              <span class="st st-merged">
                                <i />
                                Merged
                              </span>
                            </span>
                            <span
                              class="ex-rev"
                              set:html={
                                face('E1', column.key) + face('E2', column.key)
                              }
                            />
                          </div>
                          {column.key === REST && (
                            <span class="gh-hover" data-hover="example" />
                          )}
                        </article>
                      )}
                    </div>
                    <div class="gh-stage" />
                  </div>
                );
              })
            }
          </div>
          <div class="gh-floor" set:html={storyboard} />
        </div>
      </div>
    </div>
  </div>

  <div
    class="wb-colnav"
    role="group"
    aria-label="Board columns"
    data-figure-chrome
    hidden
  >
    {
      COLUMNS.map((column) => (
        <button
          type="button"
          data-col-button={column.key}
          aria-pressed={column.key === REST ? 'true' : 'false'}
        >
          {column.name}
        </button>
      ))
    }
  </div>

  <figcaption
    class="kit-plate__bar kit-plate__bar--bottom wb-caption"
    id="wb-caption"
  >
    Real cards, {fetched}. The moving card is an example.
  </figcaption>
</figure>
