---
/**
 * The working groups' transit line (site redesign spec §4.3 C2, #454): a mechanism plate, the
 * shared rail of the group cards below it. One ion line runs through three swimlanes; a white stud
 * rides it from the start and a teal hex joins at the model step, and both rest on the map's
 * stretch. Server-rendered in its final state, in both layouts (`transit-route.ts`); `transit.ts`
 * plays the entrance once and lights a group's lane from its card.
 */
import Plate from '../kit/Plate.astro';
import { ICON_PATHS } from '../kit/icons';
import {
  TRANSIT_LAYOUTS,
  buildRoute,
  laneStretches,
  lengthAt,
  slicePath,
  tokenFrame,
  type Label,
  type StationIcon,
  type TransitLayout,
} from './transit-route';

const ALT =
  'One line runs from literature to a population registry and observations, owned by Data; drops to the Modeling lane for frequency surfaces and burden estimates; returns to Data for the data service; and ends at the globe and map, owned by UI, with a future guide.';

const f = (value: number) => Math.round(value * 100) / 100;
const hex = (r: number) =>
  'M' +
  Array.from({ length: 6 }, (_, k) => {
    const a = (Math.PI / 3) * k;
    return `${f(r * Math.cos(a))} ${f(r * Math.sin(a))}`;
  }).join('L') +
  'Z';
// Burden & risk has no icon in the kit sprite: rising bars on the same 24-unit grid.
const BARS = 'M4.5 19.5h15M7.5 19.5v-5M11 19.5v-9M14.5 19.5v-12M18 19.5v-7';
const ICONS: Partial<Record<StationIcon, string>> = {
  document: ICON_PATHS.document,
  pin: ICON_PATHS.pin,
  cylinder: ICON_PATHS.cylinder,
  globe: ICON_PATHS.globe,
  speech: ICON_PATHS.speech,
  bars: BARS,
};

interface Drawn {
  layout: TransitLayout;
  d: string;
  stretches: { lane: string; d: string }[];
  spur: string;
  stud: { x: number; y: number };
  hex: { x: number; y: number };
  reached: Record<string, number>;
}

const drawn: Drawn[] = [TRANSIT_LAYOUTS.h, TRANSIT_LAYOUTS.v].map((layout) => {
  const route = buildRoute(layout);
  const rest = tokenFrame(layout, route, 1);
  const [a, b] = layout.spur;
  return {
    layout,
    d: route.d,
    stretches: laneStretches(layout, route).map((stretch) => ({
      lane: stretch.lane,
      d: slicePath(route, stretch.from, stretch.to),
    })),
    spur: `M${a.x} ${a.y}L${b.x} ${b.y}`,
    stud: rest.stud.point,
    hex: rest.hex!.point,
    // How far along the line each station sits, as a share: the entrance lights it on arrival.
    reached: Object.fromEntries(
      layout.stations.map((station) => [
        station.key,
        f(lengthAt(route, station) / route.length),
      ]),
    ),
  };
});

/** Text lines as tspans: later lines step down by the layout's line height. */
const lines = (layout: TransitLayout, label: Label) =>
  label.lines.map((line, index) => ({
    line,
    dy: index === 0 ? 0 : layout.lineHeight,
  }));
const at = (point: { x: number; y: number }) =>
  `translate(${f(point.x)} ${f(point.y)})`;
---

<Plate graphic="transit-line" class="wg-transit" label={ALT}>
  {
    drawn.map(({ layout, d, stretches, spur, stud, hex: hexAt, reached }) => (
      <svg
        class={`wg-transit__svg wg-transit__svg--${layout.id}`}
        viewBox={`0 0 ${layout.width} ${layout.height}`}
        style={`max-width: ${layout.maxWidth}px`}
        data-layout={layout.id}
        aria-hidden="true"
        focusable="false"
      >
        <g class="wg-lanes">
          {layout.lanes.map((band) => (
            <g class="wg-lane" data-lane={band.lane}>
              <rect
                class="wg-lane__band"
                x={band.x}
                y={band.y}
                width={band.width}
                height={band.height}
              />
              {band.bracket && (
                <path
                  class="wg-lane__bracket"
                  d={`M${band.bracket.x + 5} ${band.bracket.y}H${band.bracket.x}V${band.bracket.y + band.bracket.length}H${band.bracket.x + 5}`}
                />
              )}
              <text
                class="wg-lane__name"
                x={band.name.x}
                y={band.name.y}
                text-anchor={band.name.anchor}
                transform={
                  band.name.rotate
                    ? `rotate(-90 ${band.name.x} ${band.name.y})`
                    : undefined
                }
              >
                {lines(layout, band.name).map(({ line, dy }) => (
                  <tspan x={band.name.x} dy={dy}>
                    {line}
                  </tspan>
                ))}
              </text>
              <rect
                class="wg-lane__hit"
                data-lane-hit={band.lane}
                x={band.x}
                y={band.y}
                width={layout.id === 'h' ? 150 : 36}
                height={band.height}
              />
            </g>
          ))}
          {layout.id === 'h' && (
            <path
              class="wg-lane__rule"
              d={layout.lanes
                .slice(1)
                .map((band) => `M0 ${band.y + 0.5}H${layout.width}`)
                .join('')}
            />
          )}
        </g>
        <path class="wg-line wg-line--track" d={d} />
        <path class="wg-line wg-line--lit" d={d} pathLength="1" data-line />
        {stretches.map((stretch) => (
          <path
            class="wg-line wg-line--stretch"
            data-lane={stretch.lane}
            d={stretch.d}
          />
        ))}
        <path class="wg-line wg-line--future" d={spur} />
        <g class="wg-step">
          <path
            class="wg-step__hex"
            transform={at(layout.modelStepLabel.glyph)}
            d={hex(7)}
          />
          <text
            class="wg-step__label"
            x={layout.modelStepLabel.x}
            y={layout.modelStepLabel.y}
          >
            {layout.modelStepLabel.lines[0]}
          </text>
        </g>
        {layout.stations.map((station) => (
          <g
            class:list={['wg-station', station.future && 'wg-station--future']}
            data-station={station.key}
            data-lane={station.lane}
            data-reach={reached[station.key]}
          >
            <g class="wg-station__art" transform={at(station)}>
              <circle class="wg-station__ring" r={layout.stationRadius} />
              {station.icon === 'stud' ? (
                <>
                  <circle class="wg-stud__ring" r="5.75" />
                  <circle class="wg-stud" r="4.25" />
                </>
              ) : station.icon === 'hex' ? (
                <path class="wg-hexmark" d={hex(7.5)} />
              ) : (
                <svg
                  class="wg-station__icon"
                  x="-9"
                  y="-9"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                >
                  <path d={ICONS[station.icon]} />
                </svg>
              )}
            </g>
            <text
              class="wg-station__label"
              x={station.label.x}
              y={station.label.y}
              text-anchor={station.label.anchor}
            >
              {lines(layout, station.label).map(({ line, dy }) => (
                <tspan x={station.label.x} dy={dy}>
                  {line}
                </tspan>
              ))}
            </text>
          </g>
        ))}
        <g
          class="wg-token wg-token--hex"
          data-token="hex"
          transform={at(hexAt)}
        >
          <path d={hex(8)} />
        </g>
        <g
          class="wg-token wg-token--stud"
          data-token="stud"
          transform={at(stud)}
        >
          <circle class="wg-stud__ring" r="6.5" />
          <circle class="wg-stud" r="5" />
        </g>
      </svg>
    ))
  }
  <p slot="caption" class="wg-transit__legend">
    <strong>One line carries evidence to the map.</strong> Each group owns a stretch
    of it. Groups are an invitation, not a boundary.
  </p>
</Plate>

<script>
  import './transit';
</script>
