---
/**
 * How the working groups fit together (site redesign spec §4.3 C2; round 2 spec §4.3.3, #454): the
 * transit line, a mechanism plate in its own section after the orbit scene (owner: "the flow ...
 * should come after the orbit scene"). One ion line runs through three swimlanes; a white stud
 * rides it from the start and a teal hex joins at the model step, and both rest on the map's
 * stretch. Server-rendered in its final state, in both layouts (`transit-route.ts`); `transit.ts`
 * (the page's island) plays the entrance once at 35% visible and lights a group's lane from that
 * lane's own label.
 *
 * The drawing is decorative (aria-hidden) and holds no tab stop (spec §8.8); each lane label has a
 * real button laid over it, so a lane lights by hover, tap or keyboard focus, and pins on press
 * (spec §4.3.3; review of T4, finding 3). The stage is a group named by the line's description.
 */
import Plate from '../kit/Plate.astro';
import { ICON_PATHS } from '../kit/icons';
import {
  TRANSIT_LAYOUTS,
  buildRoute,
  laneStretches,
  lengthAt,
  slicePath,
  tokenAt,
  tokenPlan,
  type Label,
  type StationIcon,
  type TransitLayout,
} from './transit-route';

const ALT =
  'One line runs from literature to a population registry and observations, owned by Data; drops to the Modeling lane for frequency surfaces and burden estimates; returns to Data for the data service; and ends at the globe and map, owned by UI, with a future guide.';

const f = (value: number) => Math.round(value * 100) / 100;
const hex = (r: number) =>
  'M' +
  Array.from({ length: 6 }, (_, k) => {
    const a = (Math.PI / 3) * k;
    return `${f(r * Math.cos(a))} ${f(r * Math.sin(a))}`;
  }).join('L') +
  'Z';
// Burden & risk has no icon in the kit sprite: rising bars on the same 24-unit grid.
const BARS = 'M4.5 19.5h15M7.5 19.5v-5M11 19.5v-9M14.5 19.5v-12M18 19.5v-7';
const ICONS: Partial<Record<StationIcon, string>> = {
  document: ICON_PATHS.document,
  pin: ICON_PATHS.pin,
  cylinder: ICON_PATHS.cylinder,
  globe: ICON_PATHS.globe,
  speech: ICON_PATHS.speech,
  bars: BARS,
};

interface Drawn {
  layout: TransitLayout;
  d: string;
  stretches: { lane: string; d: string }[];
  spur: string;
  stud: { x: number; y: number };
  /** Where the stud waits before the entrance: the head of the line (the pre-paint arm). */
  start: { x: number; y: number };
  hex: { x: number; y: number };
  reached: Record<string, number>;
  /** What the island needs to replay the entrance (transit.ts). */
  plan: string;
}

const drawn: Drawn[] = [TRANSIT_LAYOUTS.h, TRANSIT_LAYOUTS.v].map((layout) => {
  const route = buildRoute(layout);
  const plan = tokenPlan(layout, route);
  const rest = tokenAt(route, plan, 1);
  const [a, b] = layout.spur;
  return {
    layout,
    d: route.d,
    stretches: laneStretches(layout, route).map((stretch) => ({
      lane: stretch.lane,
      d: slicePath(route, stretch.from, stretch.to),
    })),
    spur: `M${a.x} ${a.y}L${b.x} ${b.y}`,
    plan: JSON.stringify(plan),
    stud: rest.stud.point,
    start: tokenAt(route, plan, 0).stud.point,
    hex: rest.hex!.point,
    // How far along the line each station sits, as a share: the entrance lights it on arrival.
    reached: Object.fromEntries(
      layout.stations.map((station) => [
        station.key,
        f(lengthAt(route, station) / route.length),
      ]),
    ),
  };
});

/** The groups' names for their lane buttons (the drawing shows them shorter on phones). */
const LANE_NAMES = {
  data: 'Data & Infrastructure',
  modeling: 'Statistical & AI Modeling',
  ui: 'UI & Applications',
} as const;
const pct = (value: number, of: number) => `${f((value / of) * 100)}%`;
/**
 * A button over each lane's label, as a share of the drawing: the label and room around it on the
 * wide layout; the bracket and its upright tag on phones. A lane drawn twice (Data, on phones)
 * has one button in the tab order; its other label is a pointer target only.
 */
const laneButtons = (layout: TransitLayout) => {
  const seen = new Set<string>();
  return layout.lanes.map((band) => {
    const box =
      layout.id === 'h'
        ? { x: 4, y: band.y + 18, width: 128, height: 66 }
        : {
            x: 0,
            y: band.bracket!.y - 8,
            width: 40,
            height: band.bracket!.length + 16,
          };
    const first = !seen.has(band.lane);
    seen.add(band.lane);
    return {
      lane: band.lane,
      name: LANE_NAMES[band.lane],
      first,
      style: `left:${pct(box.x, layout.width)};top:${pct(box.y, layout.height)};width:${pct(box.width, layout.width)};height:${pct(box.height, layout.height)}`,
    };
  });
};

/** Text lines as tspans: later lines step down by the layout's line height. */
const lines = (layout: TransitLayout, label: Label) =>
  label.lines.map((line, index) => ({
    line,
    dy: index === 0 ? 0 : layout.lineHeight,
  }));
const at = (point: { x: number; y: number }) =>
  `translate(${f(point.x)} ${f(point.y)})`;
---

<Plate graphic="transit-line" class="wg-transit" label={ALT} interactive>
  {
    drawn.map(
      ({
        layout,
        d,
        stretches,
        spur,
        stud,
        start,
        hex: hexAt,
        reached,
        plan,
      }) => (
        <div
          class={`wg-transit__layout wg-transit__layout--${layout.id}`}
          style={`max-width: ${layout.maxWidth}px`}
        >
          <svg
            class="wg-transit__svg"
            viewBox={`0 0 ${layout.width} ${layout.height}`}
            data-layout={layout.id}
            data-plan={plan}
            aria-hidden="true"
            focusable="false"
          >
            <g class="wg-lanes">
              {layout.lanes.map((band) => (
                <g class="wg-lane" data-lane={band.lane}>
                  <rect
                    class="wg-lane__band"
                    x={band.x}
                    y={band.y}
                    width={band.width}
                    height={band.height}
                  />
                  {band.bracket && (
                    <path
                      class="wg-lane__bracket"
                      d={`M${band.bracket.x + 5} ${band.bracket.y}H${band.bracket.x}V${band.bracket.y + band.bracket.length}H${band.bracket.x + 5}`}
                    />
                  )}
                  <text
                    class="wg-lane__name"
                    x={band.name.x}
                    y={band.name.y}
                    text-anchor={band.name.anchor}
                    transform={
                      band.name.rotate
                        ? `rotate(-90 ${band.name.x} ${band.name.y})`
                        : undefined
                    }
                  >
                    {lines(layout, band.name).map(({ line, dy }) => (
                      <tspan x={band.name.x} dy={dy}>
                        {line}
                      </tspan>
                    ))}
                  </text>
                </g>
              ))}
              {layout.id === 'h' && (
                <path
                  class="wg-lane__rule"
                  d={layout.lanes
                    .slice(1)
                    .map((band) => `M0 ${band.y + 0.5}H${layout.width}`)
                    .join('')}
                />
              )}
            </g>
            <path class="wg-line wg-line--track" d={d} />
            <path class="wg-line wg-line--lit" d={d} pathLength="1" data-line />
            {stretches.map((stretch) => (
              <path
                class="wg-line wg-line--stretch"
                data-lane={stretch.lane}
                d={stretch.d}
              />
            ))}
            <path class="wg-line wg-line--future" d={spur} />
            <g class="wg-step">
              <path
                class="wg-step__hex"
                transform={at(layout.modelStepLabel.glyph)}
                d={hex(7)}
              />
              <text
                class="wg-step__label"
                x={layout.modelStepLabel.x}
                y={layout.modelStepLabel.y}
              >
                {layout.modelStepLabel.lines[0]}
              </text>
            </g>
            {layout.stations.map((station) => (
              <g
                class:list={[
                  'wg-station',
                  station.future && 'wg-station--future',
                ]}
                data-station={station.key}
                data-lane={station.lane}
                data-reach={reached[station.key]}
              >
                <g class="wg-station__art" transform={at(station)}>
                  <circle class="wg-station__ring" r={layout.stationRadius} />
                  {station.icon === 'stud' ? (
                    <>
                      <circle class="wg-stud__ring" r="5.75" />
                      <circle class="wg-stud" r="4.25" />
                    </>
                  ) : station.icon === 'hex' ? (
                    <path class="wg-hexmark" d={hex(7.5)} />
                  ) : (
                    <svg
                      class="wg-station__icon"
                      x="-9"
                      y="-9"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                    >
                      <path d={ICONS[station.icon]} />
                    </svg>
                  )}
                </g>
                <text
                  class="wg-station__label"
                  x={station.label.x}
                  y={station.label.y}
                  text-anchor={station.label.anchor}
                >
                  {lines(layout, station.label).map(({ line, dy }) => (
                    <tspan x={station.label.x} dy={dy}>
                      {line}
                    </tspan>
                  ))}
                </text>
              </g>
            ))}
            <g
              class="wg-token wg-token--hex"
              data-token="hex"
              transform={at(hexAt)}
            >
              <path d={hex(8)} />
            </g>
            <g
              class="wg-token wg-token--stud"
              data-token="stud"
              transform={at(stud)}
              style={`--wg-start: translate(${f(start.x)}px, ${f(start.y)}px)`}
            >
              <circle class="wg-stud__ring" r="6.5" />
              <circle class="wg-stud" r="5" />
            </g>
          </svg>
          <div
            class="wg-transit__lanes"
            role="group"
            aria-label="Light a group’s lane on the line"
            data-select="multiple"
          >
            {laneButtons(layout).map((button) => (
              <button
                type="button"
                class="wg-lane-button"
                data-lane-button={button.lane}
                aria-pressed="false"
                style={button.style}
                tabindex={button.first ? undefined : '-1'}
                aria-hidden={button.first ? undefined : 'true'}
              >
                {button.first && (
                  <span class="visually-hidden">{button.name}</span>
                )}
              </button>
            ))}
          </div>
        </div>
      ),
    )
  }
  <p slot="caption" class="wg-transit__legend">
    <strong>One line carries evidence to the map.</strong> Each group owns a stretch
    of it.
  </p>
</Plate>
