---
/**
 * A working group's vignette (site redesign spec §4.3 C2, #454): the group's stretch of the work
 * in Atlas marks, with no words (the card beside it carries the meaning, so the art is hidden from
 * assistive technology). The art is computed at build time in `vignette-art.ts`; its entrance and
 * hover replay are CSS keyframes started by `transit.ts`, and the markup is the final frame.
 */
import { VIGNETTE_SIZE, vignetteArt, type VignetteKind } from './vignette-art';

interface Props {
  kind: VignetteKind;
}

const { kind } = Astro.props;
---

<svg
  class={`wg-vig wg-vig--${kind}`}
  viewBox={`0 0 ${VIGNETTE_SIZE.width} ${VIGNETTE_SIZE.height}`}
  aria-hidden="true"
  focusable="false"
  data-wg-vig={kind}
  set:html={vignetteArt(kind)}
/>
