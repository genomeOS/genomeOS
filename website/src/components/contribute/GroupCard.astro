---
/**
 * A working group card (site redesign spec §4.3 C2, #454): its vignette, name, the aurora "Group
 * forming" badge, a scope line of 25 words or fewer, skill chips, and the group's issue filter.
 * The issue link is the card's only tab stop; hovering or focusing the card lights the group's
 * lane on the transit line above (`transit.ts`).
 */
import GroupVignette from './GroupVignette.astro';
import type { VignetteKind } from './vignette-art';

interface Props {
  id: string;
  lane: VignetteKind;
  title: string;
  scope: string;
  /** A lead-in shown with the future marker, e.g. "Future exploration:". */
  future?: { before: string; lead: string; after: string };
  chips: readonly string[];
  issues: string;
}

const { id, lane, title, scope, future, chips, issues } = Astro.props;
const titleId = `${id}-title`;
---

<article class="wg-card" id={id} data-wg-card={lane} aria-labelledby={titleId}>
  <GroupVignette kind={lane} />
  <h3 class="wg-card__title" id={titleId}>{title}</h3>
  <p class="wg-card__badge"><span>Group forming</span></p>
  {
    future ? (
      <p class="wg-card__scope">
        {future.before} <span class="wg-card__future">{future.lead}</span>{' '}
        {future.after}
      </p>
    ) : (
      <p class="wg-card__scope">{scope}</p>
    )
  }
  <ul class="wg-card__chips">
    {chips.map((chip) => <li>{chip}</li>)}
  </ul>
  <a
    class="wg-card__link"
    href={issues}
    target="_blank"
    rel="noopener noreferrer"
    aria-describedby={titleId}
    >Browse matching issues <span aria-hidden="true">↗</span></a
  >
</article>
