---
/**
 * Starlight's docs footer plus the site's Contact link (Contact page spec §1), its Privacy and
 * Cookie settings links and the cookie control (#422), so the docs carry the same analytics
 * controls as the site layout. Contact stands beside the Site policies nav, as in SiteFooter.
 */
import Default from '@astrojs/starlight/components/Footer.astro';

import CookieControl from '../CookieControl.astro';
import CookieSettings from '../CookieSettings.astro';
import { sitePath } from '../../lib/paths';
---

<Default />
<div class="docs-site-links">
  <a href={sitePath('/contact/')}>Contact</a>
  <nav class="docs-site-links__policies" aria-label="Site policies">
    <a href={sitePath('/privacy/')}>Privacy</a>
    <CookieSettings class="docs-site-links__button" />
  </nav>
</div>
<CookieControl />

<style>
  @layer starlight.core {
    .docs-site-links,
    .docs-site-links__policies {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      justify-content: center;
    }

    .docs-site-links {
      /* Clear of the previous and next cards above (design review, round 3). */
      margin-block: 2rem 1.5rem;
      font-size: var(--sl-text-sm);
    }

    .docs-site-links a,
    .docs-site-links :global(.docs-site-links__button) {
      min-height: 24px;
      margin: 0;
      padding: 0;
      display: inline-flex;
      align-items: center;
      border: 0;
      background: none;
      color: var(--sl-color-gray-3);
      font: inherit;
      text-decoration: underline;
      text-underline-offset: 0.2em;
      cursor: pointer;
    }

    .docs-site-links a:hover,
    .docs-site-links :global(.docs-site-links__button:hover) {
      color: var(--sl-color-white);
    }

    /* One centred column where the three links no longer fit one row, never one above two
       (design critique 3, m-5), as in SiteFooter. */
    @media (max-width: 22rem) {
      .docs-site-links,
      .docs-site-links__policies {
        flex-direction: column;
        align-items: center;
      }
    }
  }
</style>
