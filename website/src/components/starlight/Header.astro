---
/**
 * The docs header (site redesign spec §1.5, #454): the site's own lockup, nav and Atlas link around
 * Starlight's search, so the docs read as part of the site. The nav (Projects · Contribute · Docs ·
 * Contact · GitHub, Docs current) shows from 72em; below that the sidebar's "Explore the site" group
 * carries the page links. GitHub shows from 50em, where the sidebar stops being the mobile menu
 * (whose footer carries the social icons), so the repository is one click away at every width.
 *
 * The Atlas link is the site header's pill (design critique of the integrated build: the docs bar
 * had a plain outline with no globe, no arrow and no glow): SiteHeader.astro's .launch-atlas-cta,
 * a black pill in an aurora rim with a globe and the arrow, its aurora's glow held still where the
 * site's comes to rest (no motion on the docs), in the site's compact form where room is short.
 * The globe is the kit's line globe, inline, not the favicon artwork (a 6 KB image past the docs'
 * budget). The phone bar's menu is the
 * site's "Menu +" (MobileMenuToggle.astro).
 *
 * Design review, round 2: it reads in the site header's order and type, so going from a site page
 * to Docs the primary nav neither jumps across the row nor changes weight: the lockup, the nav
 * directly after it, then Search and the Atlas link on the right (DOM order too, so focus follows);
 * labels at the site's weight and colours (muted, the current page starlight); every item centring
 * its link, so GitHub's label shares the others' baseline.
 *
 * Design review, round 3: the lockup and the nav also stand where the site's compact header puts
 * them. From 50em the header's contents sit in the site's content column (starlight.css pads the
 * bar to the site gutter and the 76rem container), the lockup is the compact one (2.6rem tall, the
 * site's --lockup-compact-width) and, as on the site, it keeps the landing lockup's slot, so the
 * nav starts where it starts on every site page.
 *
 * Contact page spec §1 (review 3, I-1): Contact lengthens the nav, and Search has only the room the
 * nav leaves, 75 px at 1,152 px, where the whole button needs about 164 px. Squeezed, its
 * magnifier shrank to nothing and its key hint ran onto the Atlas link. So Search is a size
 * container, and where its room is too small its button sheds the key hint, then its label,
 * leaving the outlined square magnifier (Starlight's own phone header shows that). It keeps the
 * name "Search" and Ctrl/⌘ K, and no nav item moves or goes.
 *
 * Round 2 (spec §4.4, R2-9; docs-light.md V1): the docs read on paper under this bar, which stays
 * the site's dark bar exactly (starlight.css gives the header subtree the dark tokens back). The
 * "Dark theme" toggle (ThemeSelect.astro) sits from 50em between Search and the Atlas link, half a
 * rem after Search: the two docs tools read as one pair. Search, the size container, gives up the
 * toggle's room first (spec §1.1, plan T6), so it sheds its key hint a little sooner than before.
 * Where the whole nav first shows (72em to 78em) even the bare magnifier and the toggle had no room
 * left, so there the row's gaps close to half a rem (the lockup keeping its slot, so the nav stands
 * where the site's does) and the Atlas link takes the site pill's compact form. Nothing in the nav
 * moves or goes.
 */
import Search from '@astrojs/starlight/components/Search.astro';

import GitHubLink from '../GitHubLink.astro';
import ThemeSelect from './ThemeSelect.astro';
import EncodingStyle from '../kit/EncodingStyle.astro';
import { PRIMARY_NAV } from '../../data/nav';
import { ICON_PATHS } from '../kit/icons';
import { sitePath } from '../../lib/paths';
import '../../styles/tokens.css';
---

<div class="docs-header">
  <a class="docs-header__home" href={sitePath('/')}>
    <img
      class="docs-header__lockup"
      src={sitePath('/brand/genomeos-lockup-dark.svg')}
      width="1395"
      height="300"
      alt="genomeOS Foundation"
      decoding="async"
    />
  </a>
  <nav class="docs-header__nav print:hidden" aria-label="Primary navigation">
    <ul>
      {
        PRIMARY_NAV.map(({ label, href }) => (
          <li>
            <a
              href={sitePath(href)}
              aria-current={href === '/docs/' ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="docs-header__github"><GitHubLink /></li>
    </ul>
  </nav>
  <div class="docs-header__tools print:hidden">
    <div class="docs-header__search">
      <Search />
    </div>
    <ThemeSelect place="header" />
  </div>
  <a class="docs-header__atlas print:hidden" href={sitePath('/app/')}>
    <svg
      class="docs-header__atlas-mark"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path d={ICON_PATHS.globe}></path>
    </svg>
    <span class="docs-header__atlas-label">
      <span class="brand-name">genomeOS</span> Atlas
    </span>
    <svg
      class="docs-header__atlas-arrow"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M5 12h13M13 6l6 6-6 6"></path>
    </svg>
  </a>
</div>
<EncodingStyle />

<style>
  @layer starlight.core {
    .docs-header {
      display: flex;
      align-items: center;
      gap: var(--sl-nav-gap);
      height: 100%;
    }

    .docs-header__home {
      flex: none;
      display: flex;
      align-items: center;
      min-width: 0;
    }

    .docs-header__lockup {
      width: auto;
      height: 2rem;
    }

    /* The docs tools, Search and the theme toggle, take the room the nav leaves, set against the
       Atlas link on the right, half a rem apart. */
    .docs-header__tools {
      display: flex;
      flex: 1 1 auto;
      align-items: center;
      justify-content: flex-end;
      gap: 0.5rem;
      min-width: 0;
    }

    /* Search takes what the toggle leaves. It is a size container, so its button can fit that room
       (the utility layer, below). */
    .docs-header__search {
      container: docs-search / inline-size;
      display: flex;
      flex: 1 1 auto;
      justify-content: flex-end;
      min-width: 0;
    }

    /* The magnifier keeps its size: a flex item, it would otherwise shrink first. */
    .docs-header__search :global(button[data-open-modal] > svg) {
      flex: none;
    }

    .docs-header__nav {
      display: none;
    }

    /* The site header's spacing (global.css, .desktop-nav). */
    .docs-header__nav ul {
      display: flex;
      align-items: center;
      gap: clamp(1rem, 5.9vw - 2.6rem, 2.25rem);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* Each item centres its link, as on the site: GitHub's inline-flex link would otherwise take
       its baseline from the icon and set its label above the others. */
    .docs-header__nav li {
      display: flex;
      align-items: center;
    }

    /* The site header's labels: Figtree 400 at 1rem in muted. */
    .docs-header__nav :global(a) {
      color: var(--color-muted);
      font-size: 1rem;
      font-weight: 400;
      text-decoration: none;
      white-space: nowrap;
    }

    /* The current page reads as on the site's header: starlight, no underline. */
    .docs-header__nav :global(a:hover),
    .docs-header__nav a[aria-current='page'] {
      color: var(--color-starlight);
    }

    .docs-header__nav :global(.github-link) {
      display: inline-flex;
      align-items: center;
      gap: 0.48rem;
    }

    .docs-header__nav :global(.github-link svg) {
      width: 1.2rem;
      height: 1.2rem;
      fill: currentColor;
    }

    /* The site's pill (global.css .launch-atlas-cta) in the compact form the site's header takes
       where its nav first shows (72.01rem to 87rem): the globe, the label and no arrow, a black fill
       in an aurora rim, and the aurora's glow held still round it, where the site's comes to rest.
       A shadow, not the site's blurred curtains, which would reach past the bar's row. */
    .docs-header__atlas {
      position: relative;
      isolation: isolate;
      display: none;
      flex: none;
      align-items: center;
      gap: 0.4rem;
      min-height: 2.5rem;
      padding: 0.55rem 0.75rem 0.55rem 0.5rem;
      border-radius: 999px;
      box-shadow:
        -0.55rem 0 1.1rem -0.2rem rgb(114 231 193 / 42%),
        0 0 1.1rem -0.1rem rgb(18 255 255 / 30%),
        0.55rem 0 1.1rem -0.2rem rgb(138 92 255 / 42%);
      color: #f2f8ff;
      font-size: 0.84rem;
      font-weight: 720;
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
      transition:
        transform 220ms cubic-bezier(0.2, 0.75, 0.25, 1),
        box-shadow 260ms ease;
    }

    .docs-header__atlas::before {
      position: absolute;
      z-index: -1;
      inset: 0;
      border: 1px solid transparent;
      border-radius: inherit;
      background:
        linear-gradient(#000, #000) padding-box,
        linear-gradient(
            100deg,
            rgb(114 231 193 / 70%),
            rgb(18 255 255 / 45%),
            rgb(138 92 255 / 70%)
          )
          border-box;
      content: '';
    }

    .docs-header__atlas:hover,
    .docs-header__atlas:focus-visible {
      transform: translateY(-1px);
      box-shadow:
        -0.6rem 0 1.3rem -0.1rem rgb(114 231 193 / 55%),
        0 0 1.3rem 0 rgb(18 255 255 / 40%),
        0.6rem 0 1.3rem -0.1rem rgb(138 92 255 / 55%);
    }

    /* The kit's line globe in ion, drawn inline: the site pill's favicon artwork would add a 6 KB
       image to every docs page, past the docs' budget (spec §7: Starlight's baseline plus the
       theme's CSS). */
    .docs-header__atlas-mark {
      flex: none;
      width: 1.2rem;
      height: 1.2rem;
      fill: none;
      stroke: #70e6ff;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.7;
    }

    .docs-header__atlas-label .brand-name {
      font-weight: 400;
    }

    /* The arrow shows where the bar has room for the site's whole pill (below). */
    .docs-header__atlas-arrow {
      display: none;
      flex: none;
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: #70e6ff;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 2.2;
      transition: transform 220ms cubic-bezier(0.2, 0.75, 0.25, 1);
    }

    .docs-header__atlas:hover .docs-header__atlas-arrow,
    .docs-header__atlas:focus-visible .docs-header__atlas-arrow {
      transform: translateX(3px);
    }

    @media (prefers-reduced-motion: reduce) {
      .docs-header__atlas,
      .docs-header__atlas-arrow {
        transition: none;
      }
    }

    @media (forced-colors: active) {
      .docs-header__atlas {
        box-shadow: none;
      }

      .docs-header__atlas::before {
        border-color: ButtonText;
        background: Canvas;
      }

      .docs-header__atlas-arrow,
      .docs-header__atlas-mark {
        stroke: ButtonText;
      }
    }

    @media (min-width: 50em) {
      /* The site's compact lockup: 2.6rem tall, so calc(2.6rem * 1395 / 300) wide (global.css). */
      .docs-header__lockup {
        height: 2.6rem;
      }

      .docs-header__atlas {
        display: inline-flex;
      }

      .docs-header__nav {
        display: block;
      }

      .docs-header__nav li:not(.docs-header__github) {
        display: none;
      }
    }

    /* The whole nav, set after the lockup with the site header's room (global.css): the row gap
       (1.25rem), and after the lockup the rest of the landing lockup's slot, which the site's
       brand slot keeps when its header is compact, then the nav's own margin. */
    @media (min-width: 72em) {
      .docs-header {
        gap: 1.25rem;
      }

      .docs-header__home {
        margin-inline-end: calc((3.6rem - 2.6rem) * 1395 / 300);
      }

      .docs-header__nav {
        margin-inline-start: clamp(0rem, 9.7vw - 6.22rem, 2.25rem);
      }

      .docs-header__nav li:not(.docs-header__github) {
        display: flex;
      }
    }

    /* Where the whole nav first shows, the bare magnifier and the toggle need about 45 px more than
       the row leaves: the gaps close to half a rem (the lockup's slot grows by what its gap gave
       up, so the nav does not move) and the Atlas link takes the site pill's type size. */
    @media (72em <= width < 78em) {
      .docs-header {
        gap: 0.5rem;
      }

      .docs-header__home {
        margin-inline-end: calc((3.6rem - 2.6rem) * 1395 / 300 + 0.75rem);
      }
    }

    /* The site's whole pill, with its arrow, where Search keeps its label and key hint beside it:
       with only GitHub in the nav (56em to 72em), and once the bar is wide again (from 92em). */
    @media (56em <= width < 72em), (min-width: 92em) {
      .docs-header__atlas {
        padding-right: 0.95rem;
      }

      .docs-header__atlas-arrow {
        display: block;
      }
    }

    /* A phone bar: the lockup gives way so Search and "Menu +" keep their room (the site's phone
       header does the same, global.css). */
    @media (max-width: 49.99em) {
      .docs-header__lockup {
        width: min(
          calc(2rem * 1395 / 300),
          100vw - 2 * var(--sl-nav-pad-x) - 9.6rem
        );
        height: auto;
      }
    }
  }

  /* Search's button in the room the nav leaves (Contact page spec §1). Whole, it needs about 9.1rem
     with "Ctrl K" (8.5rem with "⌘ K"), and without the key hint about 6rem; each step keeps a
     little slack for font metrics. This sits in Starlight's utility layer, after the md:sl-flex and
     md:sl-block utilities that would otherwise show the hint and the label again. From 50em only:
     below that Starlight already shows the bare magnifier. */
  @layer starlight.utils {
    @media (min-width: 50em) {
      @container docs-search (max-width: 9.5rem) {
        .docs-header__search :global(button[data-open-modal] > kbd) {
          display: none;
        }
      }

      /* Just the magnifier, in the outlined square: 2.5rem, as tall as before, so 45 px across. */
      @container docs-search (max-width: 6.5rem) {
        .docs-header__search :global(button[data-open-modal]) {
          justify-content: center;
          width: 2.5rem;
          padding-inline: 0;
        }

        .docs-header__search :global(button[data-open-modal] > span) {
          display: none;
        }
      }
    }
  }
</style>
