---
/**
 * The docs header (site redesign spec §1.5, #454): the site's own lockup, nav and Atlas link around
 * Starlight's search, so the docs read as part of the site. The nav (Project · Contribute · Docs ·
 * GitHub, Docs current) shows from 72em; below that the sidebar's "Explore the project" group
 * carries the page links. GitHub shows from 50em, where the sidebar stops being the mobile menu
 * (whose footer carries the social icons), so the repository is one click away at every width.
 * The Atlas link is a quiet outline: the aurora pill stays the site's.
 *
 * Design review, round 2: it reads in the site header's order and type, so going from a site page
 * to Docs the primary nav neither jumps across the row nor changes weight: the lockup, the nav
 * directly after it, then Search and the Atlas link on the right (DOM order too, so focus follows);
 * labels at the site's weight and colours (muted, the current page starlight); every item centring
 * its link, so GitHub's label shares the others' baseline.
 *
 * Design review, round 3: the lockup and the nav also stand where the site's compact header puts
 * them. From 50em the header's contents sit in the site's content column (starlight.css pads the
 * bar to the site gutter and the 76rem container), the lockup is the compact one (2.6rem tall, the
 * site's --lockup-compact-width) and, as on the site, it keeps the landing lockup's slot, so the
 * nav starts where it starts on every site page.
 */
import Search from '@astrojs/starlight/components/Search.astro';

import GitHubLink from '../GitHubLink.astro';
import EncodingStyle from '../kit/EncodingStyle.astro';
import { PRIMARY_NAV } from '../../data/nav';
import { sitePath } from '../../lib/paths';
import '../../styles/tokens.css';
---

<div class="docs-header">
  <a class="docs-header__home" href={sitePath('/')}>
    <img
      class="docs-header__lockup"
      src={sitePath('/brand/genomeos-lockup-dark.svg')}
      width="1395"
      height="300"
      alt="genomeOS Foundation"
      decoding="async"
    />
  </a>
  <nav class="docs-header__nav print:hidden" aria-label="Primary navigation">
    <ul>
      {
        PRIMARY_NAV.map(({ label, href }) => (
          <li>
            <a
              href={sitePath(href)}
              aria-current={href === '/docs/' ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="docs-header__github"><GitHubLink /></li>
    </ul>
  </nav>
  <div class="docs-header__search print:hidden">
    <Search />
  </div>
  <a class="docs-header__atlas print:hidden" href={sitePath('/app/')}>
    <span class="brand-name">genomeOS</span> Atlas
  </a>
</div>
<EncodingStyle />

<style>
  @layer starlight.core {
    .docs-header {
      display: flex;
      align-items: center;
      gap: var(--sl-nav-gap);
      height: 100%;
    }

    .docs-header__home {
      flex: none;
      display: flex;
      align-items: center;
      min-width: 0;
    }

    .docs-header__lockup {
      width: auto;
      height: 2rem;
    }

    /* Search takes the room the nav leaves, its field set against the Atlas link on the right. */
    .docs-header__search {
      display: flex;
      flex: 1 1 auto;
      justify-content: flex-end;
      min-width: 0;
    }

    .docs-header__nav {
      display: none;
    }

    /* The site header's spacing (global.css, .desktop-nav). */
    .docs-header__nav ul {
      display: flex;
      align-items: center;
      gap: clamp(1rem, 5.9vw - 2.6rem, 2.25rem);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* Each item centres its link, as on the site: GitHub's inline-flex link would otherwise take
       its baseline from the icon and set its label above the others. */
    .docs-header__nav li {
      display: flex;
      align-items: center;
    }

    /* The site header's labels: Figtree 400 at 1rem in muted. */
    .docs-header__nav :global(a) {
      color: var(--color-muted);
      font-size: 1rem;
      font-weight: 400;
      text-decoration: none;
      white-space: nowrap;
    }

    /* The current page reads as on the site's header: starlight, no underline. */
    .docs-header__nav :global(a:hover),
    .docs-header__nav a[aria-current='page'] {
      color: var(--color-starlight);
    }

    .docs-header__nav :global(.github-link) {
      display: inline-flex;
      align-items: center;
      gap: 0.48rem;
    }

    .docs-header__nav :global(.github-link svg) {
      width: 1.2rem;
      height: 1.2rem;
      fill: currentColor;
    }

    .docs-header__atlas {
      display: none;
      flex: none;
      align-items: center;
      min-height: 2.5rem;
      padding: 0.35rem 0.95rem;
      border: 1px solid rgb(112 230 255 / 42%);
      border-radius: 999px;
      color: var(--sl-color-white);
      font-size: var(--sl-text-sm);
      font-weight: 650;
      text-decoration: none;
      white-space: nowrap;
    }

    .docs-header__atlas:hover {
      border-color: var(--sl-color-accent);
    }

    .docs-header__atlas .brand-name {
      margin-right: 0.3em;
    }

    @media (min-width: 50em) {
      /* The site's compact lockup: 2.6rem tall, so calc(2.6rem * 1395 / 300) wide (global.css). */
      .docs-header__lockup {
        height: 2.6rem;
      }

      .docs-header__atlas {
        display: inline-flex;
      }

      .docs-header__nav {
        display: block;
      }

      .docs-header__nav li:not(.docs-header__github) {
        display: none;
      }
    }

    /* The whole nav, set after the lockup with the site header's room (global.css): the row gap
       (1.25rem), and after the lockup the rest of the landing lockup's slot, which the site's
       brand slot keeps when its header is compact, then the nav's own margin. */
    @media (min-width: 72em) {
      .docs-header {
        gap: 1.25rem;
      }

      .docs-header__home {
        margin-inline-end: calc((3.6rem - 2.6rem) * 1395 / 300);
      }

      .docs-header__nav {
        margin-inline-start: clamp(0rem, 9.7vw - 6.22rem, 2.25rem);
      }

      .docs-header__nav li:not(.docs-header__github) {
        display: flex;
      }
    }
  }
</style>
