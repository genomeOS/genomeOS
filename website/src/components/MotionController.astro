<div class="scroll-progress" aria-hidden="true"><span></span></div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  /*
   * The header compacts once scrollY passes 56 and expands again below 40.
   * Between the two it keeps its state, so a scroll that hovers near one line,
   * or a 1-3 px correction the browser makes, cannot flip it back and forth.
   * Reduced motion gets the same two states; its CSS swaps them without a
   * transition.
   */
  const HEADER_COMPACT_ABOVE = 56;
  const HEADER_EXPAND_BELOW = 40;
  let headerFrame = 0;

  const renderHeader = () => {
    headerFrame = 0;
    if (!header) return;
    const compact = header.classList.contains('site-header--compact');
    if (!compact && window.scrollY > HEADER_COMPACT_ABOVE)
      header.classList.add('site-header--compact');
    else if (compact && window.scrollY < HEADER_EXPAND_BELOW)
      header.classList.remove('site-header--compact');
  };
  const scheduleHeader = () => {
    if (!headerFrame) headerFrame = window.requestAnimationFrame(renderHeader);
  };
  window.addEventListener('scroll', scheduleHeader, { passive: true });
  renderHeader();

  if (!reducedMotion.matches) {
    document.documentElement.classList.add('motion-ready');

    const revealed = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -9% 0px', threshold: 0.08 },
    );
    revealed.forEach((element) => observer.observe(element));

    const progress = document.querySelector<HTMLElement>('.scroll-progress');
    let frame = 0;

    const renderScroll = () => {
      frame = 0;
      const pageRange =
        document.documentElement.scrollHeight - window.innerHeight;
      const pageProgress = pageRange > 0 ? window.scrollY / pageRange : 0;
      progress?.style.setProperty(
        '--scroll-progress',
        String(Math.min(1, Math.max(0, pageProgress))),
      );
    };

    const scheduleScroll = () => {
      if (!frame) frame = window.requestAnimationFrame(renderScroll);
    };
    window.addEventListener('scroll', scheduleScroll, { passive: true });
    window.addEventListener('resize', scheduleScroll, { passive: true });
    renderScroll();

    /*
     * Figures play once (site redesign spec §2.7, #454): when 35% of a [data-graphic] is in view,
     * it is marked played and told so with a `graphic:play` event; FigureController
     * (src/graphics/figure.ts) and CSS-only figures start from that. Each figure is told once. A
     * figure taller than the viewport counts once it fills 35% of the viewport.
     */
    document.documentElement.setAttribute('data-graphic-observer', '');
    const graphics = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const fills =
            entry.intersectionRect.height >= 0.35 * window.innerHeight;
          if (entry.intersectionRatio < 0.35 && !fills) continue;
          const figure = entry.target as HTMLElement;
          graphics.unobserve(figure);
          figure.setAttribute('data-graphic-played', '');
          figure.dispatchEvent(new CustomEvent('graphic:play'));
        }
      },
      { threshold: [0, 0.1, 0.2, 0.35, 0.5] },
    );
    for (const figure of document.querySelectorAll<HTMLElement>(
      '[data-graphic]',
    ))
      graphics.observe(figure);

    for (const surface of document.querySelectorAll<HTMLElement>(
      '[data-motion-surface]',
    )) {
      surface.addEventListener('pointermove', (event) => {
        if (!(event instanceof PointerEvent)) return;
        const bounds = surface.getBoundingClientRect();
        surface.style.setProperty(
          '--spotlight-x',
          `${event.clientX - bounds.left}px`,
        );
        surface.style.setProperty(
          '--spotlight-y',
          `${event.clientY - bounds.top}px`,
        );
      });
    }
  }
</script>
