---
/**
 * "or open in Gmail · Outlook", under Email us and under Open draft (Contact page spec §2, §3.1;
 * owner, 2026-10-15: on a computer whose `mailto:` handler is no desktop app, neither opened
 * anything). Quiet, after the control it backs up: each link opens its service's compose page in a
 * new tab, to the address and, under Open draft, with the draft. The served links hold no compose
 * URL: the island (contact.ts) builds each one when a visitor reaches for it, as it does Email us's
 * `mailto:`, so the address is in no served file. Until then they point at the address on the page.
 */
import { WEBMAILS, type Webmail } from '../../lib/contact-draft';
import ContactIcon from './ContactIcon.astro';

const NAMES: Record<Webmail, string> = { gmail: 'Gmail', outlook: 'Outlook' };
---

<p class="contact-alt">
  or open in{' '}
  {
    WEBMAILS.map((service, index) => (
      <>
        {index > 0 && <span aria-hidden="true"> · </span>}
        <a
          class="contact-alt__link"
          href="#contact-address"
          target="_blank"
          rel="noopener noreferrer"
          data-webmail={service}
        >
          {NAMES[service]}
          <ContactIcon name="external" class="contact-alt__icon" />
        </a>
      </>
    ))
  }
</p>
