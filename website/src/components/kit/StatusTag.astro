---
/**
 * The figure status tag (site redesign spec §2.6, round 2 spec §2.2, #454). Signal gold means only
 * validation, refusal or caution, and the marketing site has one kind left:
 *
 *   worked-example  a figure computed from stated illustrative counts, labelled "Example" (R2-15:
 *                   the counts figure on Projects, so nobody reads its surveys as real places)
 *
 * The owner retired the other two (rulings 15 and 39, 2026-10-15): "Not yet validated" became a
 * plain figure note with a link to the Atlas (`.figure-note`, R2-14), and "Schematic" went, since
 * a drawing needs no label saying it is one.
 */

type StatusKind = 'worked-example';

interface Props {
  kind: StatusKind;
  class?: string;
}

const LABEL: Record<StatusKind, string> = {
  'worked-example': 'Example',
};

const { kind, class: className } = Astro.props;
---

<span class:list={['kit-status-tag', className]} data-status={kind}
  >{LABEL[kind]}</span
>

<style is:global>
  .kit-status-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.55rem 0.22rem 0.5rem;
    border: 1px solid var(--color-signal);
    color: var(--color-signal);
    font-family: var(--font-body);
    font-size: var(--type-tag);
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }

  .kit-status-tag::before {
    content: '';
    flex: none;
    width: 0.42rem;
    height: 0.42rem;
    border: 1.5px solid currentColor;
    transform: rotate(45deg);
  }

  @media (forced-colors: active) {
    .kit-status-tag {
      border-color: CanvasText;
      color: CanvasText;
    }
  }
</style>
