---
/**
 * Tabs (site redesign spec §3, §8, #454): markup for `src/graphics/tabs.ts`, a roving-tabindex
 * tablist with exactly one selected tab. Each tab's panel comes from the slot named
 * `panel-<id>`; every panel is server-rendered, and all but the selected one are `hidden`
 * (without JS, the first-selected panel shows; print shows them all).
 *
 * Tabs wrap onto more rows when they do not fit (spec §4.3: a wrapping row on phones; labels never
 * break mid-word). Each tab draws its own hairline, so every row keeps its rule and the selected
 * tab's underline sits on its own row; a spacer carries the rule on to the end of the last row,
 * and in a narrow container the tabs stretch to fill their rows.
 */

interface Tab {
  id: string;
  label: string;
  /** A second line on the tab, e.g. its status. */
  sub?: string;
}

interface Props {
  label: string;
  tabs: Tab[];
  selected?: number;
  idPrefix: string;
  class?: string;
}

const { label, tabs, selected = 0, idPrefix, class: className } = Astro.props;
const panels = await Promise.all(
  tabs.map((tab) =>
    Astro.slots.has(`panel-${tab.id}`)
      ? Astro.slots.render(`panel-${tab.id}`)
      : Promise.resolve(''),
  ),
);
---

<div class:list={['kit-tabs', className]} data-kit-tabs>
  <div
    class="kit-tabs__list"
    role="tablist"
    aria-label={label}
    data-figure-chrome
  >
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`${idPrefix}-tab-${tab.id}`}
          aria-controls={`${idPrefix}-panel-${tab.id}`}
          aria-selected={index === selected ? 'true' : 'false'}
          tabindex={index === selected ? 0 : -1}
        >
          <span class="kit-tabs__label">{tab.label}</span>
          {tab.sub && <span class="kit-tabs__sub">{tab.sub}</span>}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab, index) => (
      <div
        class="kit-tabs__panel"
        role="tabpanel"
        id={`${idPrefix}-panel-${tab.id}`}
        aria-labelledby={`${idPrefix}-tab-${tab.id}`}
        hidden={index !== selected}
        set:html={panels[index]}
      />
    ))
  }
</div>

<script>
  import { initTabs } from '../../graphics/tabs';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-kit-tabs]:not([data-kit-tabs-ready])',
  )) {
    root.dataset.kitTabsReady = '';
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    if (list) initTabs(list);
  }
</script>

<style is:global>
  .kit-tabs {
    container: kit-tabs / inline-size;
  }

  .kit-tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }

  .kit-tabs__list::after {
    flex: 1 1 0;
    border-bottom: 1px solid var(--color-deep-line);
    content: '';
  }

  .kit-tabs__list [role='tab'] {
    display: grid;
    align-content: start;
    gap: 0.1rem;
    min-height: 2.75rem;
    margin: 0;
    padding: 0.55rem 1rem calc(0.6rem + 1px);
    border: 0;
    border-bottom: 1px solid var(--color-deep-line);
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 620;
    text-align: left;
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease-ui);
  }

  .kit-tabs__list [role='tab']:hover {
    color: var(--color-starlight);
  }

  /* A 2 px underline: the tab's own hairline turns ion, plus one more pixel above it. */
  .kit-tabs__list [role='tab'][aria-selected='true'] {
    border-bottom-color: var(--color-ion);
    box-shadow: inset 0 -1px 0 var(--color-ion);
    color: var(--color-starlight);
  }

  @container kit-tabs (max-width: 40rem) {
    .kit-tabs__list [role='tab'] {
      flex: 1 1 auto;
    }
  }

  .kit-tabs__label {
    overflow-wrap: normal;
    word-break: keep-all;
  }

  .kit-tabs__sub {
    color: var(--color-faint);
    font-size: 0.8rem;
    font-weight: 560;
  }

  .kit-tabs__panel {
    padding-top: 0.9rem;
    color: var(--color-text-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .kit-tabs__list [role='tab'] {
      transition: none;
    }
  }

  @media print {
    .kit-tabs__panel[hidden] {
      display: block;
    }
  }
</style>
