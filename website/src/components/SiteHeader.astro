---
import GitHubLink from './GitHubLink.astro';
import { PRIMARY_NAV } from '../data/nav';
import { sitePath } from '../lib/paths';
import { FAVICON_SVG } from '../lib/favicons';

const path = Astro.url.pathname;
const isAtlasPage = path === sitePath('/app/');
const links = PRIMARY_NAV;

const isCurrent = (href: string) =>
  path === sitePath(href) || path.startsWith(sitePath(href));

/*
 * Every page but the Atlas shows the genomeOS + FOUNDATION lockup, large at
 * the top of the page and compact once it scrolls. The Atlas never scrolls and
 * sizes its globe from the header, so it keeps the shorter wordmark crop.
 * The alt text is the text the image shows, so the home link's accessible
 * name matches its visible label.
 *
 * The lockup header is fixed, and a spacer of its landing height holds its
 * place in the page, so the header can change size without moving anything
 * below it (global.css, .site-header--lockup).
 */
const logo = isAtlasPage
  ? {
      src: '/brand/genomeos-wordmark-dark.svg',
      width: 1391,
      height: 228,
      alt: 'genomeOS',
    }
  : {
      src: '/brand/genomeos-lockup-dark.svg',
      width: 1395,
      height: 300,
      alt: 'genomeOS Foundation',
    };
---

<header
  class:list={['site-header', { 'site-header--lockup': !isAtlasPage }]}
  data-site-header
>
  <div class="site-header__inner">
    <div class="site-header__brand">
      <a class="wordmark" href={sitePath('/')}>
        <img
          class="wordmark__logo"
          src={sitePath(logo.src)}
          width={logo.width}
          height={logo.height}
          alt={logo.alt}
          decoding="async"
        />
      </a>
    </div>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          links.map(({ label, href }) => (
            <li>
              <a
                href={sitePath(href)}
                aria-current={isCurrent(href) ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
        <li class="desktop-nav__github"><GitHubLink /></li>
      </ul>
    </nav>

    <div class="site-header__actions">
      {
        isAtlasPage && (
          <div
            class="atlas-navbar-status-slot"
            data-atlas-status-slot
            aria-label="Atlas status"
          />
        )
      }
      {
        !isAtlasPage && (
          <div class="launch-atlas">
            <a
              class="launch-atlas-cta"
              href={sitePath('/app/')}
              aria-describedby="launch-atlas-caption"
            >
              {/* Aurora curtains behind the black button (global.css). */}
              <span class="launch-atlas-cta__lights" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
              <img
                class="launch-atlas-cta__mark"
                src={sitePath(FAVICON_SVG)}
                alt=""
                width="22"
                height="22"
              />
              <span class="launch-atlas-cta__label">
                <span class="brand-name">genomeOS</span> Atlas
              </span>
              <svg
                class="launch-atlas-cta__arrow"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M5 12h13M13 6l6 6-6 6" />
              </svg>
            </a>
            {/*
             * Shown under the button on hover and keyboard focus (global.css).
             * It is the link's description, so it stays out of its name, and
             * beside the link rather than in it, out of its text too (what a
             * crawler or a plain-text copy reads). aria-hidden keeps it from
             * being read twice; a description still reads text it points to
             * directly.
             */}
            <span
              class="launch-atlas-cta__caption"
              id="launch-atlas-caption"
              aria-hidden="true"
            >
              Explore the interactive app
            </span>
          </div>
        )
      }
      <details class="mobile-nav">
        <summary>
          {
            isAtlasPage ? (
              <>
                <span class="mobile-nav__label">Menu</span>
                <svg
                  class="mobile-nav__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
              </>
            ) : (
              'Menu'
            )
          }
        </summary>
        <nav aria-label="Mobile navigation">
          <ul>
            {
              /* Shown only when the row is too narrow for the action itself (global.css). */
              !isAtlasPage && (
                <li class="mobile-nav__launch">
                  <a href={sitePath('/app/')}>
                    <span class="brand-name">genomeOS</span> Atlas
                  </a>
                </li>
              )
            }
            {
              links.map(({ label, href }) => (
                <li>
                  <a
                    href={sitePath(href)}
                    aria-current={isCurrent(href) ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
          <GitHubLink />
        </nav>
      </details>
    </div>
  </div>
</header>
{!isAtlasPage && <div class="site-header-spacer" aria-hidden="true" />}

<script>
  /*
   * The Menu disclosure closes on Escape. Focus goes back to its summary from
   * inside the Menu or from <body>, and stays put anywhere else, so an Escape
   * never pulls focus out of another layer (an Atlas dialog). It also closes
   * on a press or a focus anywhere outside it, so the open panel never covers
   * the control that has focus or the content the next Tab goes on to from a
   * click. The window capture listener runs before the Atlas explorer's
   * Escape stack (a document capture listener): an open Menu is the innermost
   * layer, and global.css paints it as the topmost one.
   */
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(
    'details.mobile-nav',
  )) {
    const summary = menu.querySelector('summary');
    const closeFrom = (target: EventTarget | null) => {
      if (menu.open && !(target instanceof Node && menu.contains(target)))
        menu.open = false;
    };
    window.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape' || event.isComposing) return;
        // Closed, or hidden by the desktop layout after a resize.
        if (!menu.open || menu.getClientRects().length === 0) return;
        const focused = document.activeElement;
        menu.open = false;
        if (!focused || focused === document.body || menu.contains(focused))
          summary?.focus();
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );
    // Capture, so a press the Atlas globe handles still closes the Menu.
    document.addEventListener(
      'pointerdown',
      (event) => closeFrom(event.target),
      true,
    );
    document.addEventListener('focusin', (event) => closeFrom(event.target));
    // The desktop nav takes over past 72rem and hides the Menu (global.css);
    // closing it then means it never comes back already open.
    window.addEventListener('resize', () => {
      if (menu.open && menu.getClientRects().length === 0) menu.open = false;
    });
  }

  /*
   * genomeOS Atlas's aurora drifts through a visitor's first 20 s on a page,
   * counted from when the page is first in view, then holds still wherever
   * it is until the button is hovered or focused (global.css). A drift that
   * never ended kept the compositor drawing 60 frames a second, for as long
   * as the page stayed open, on a page with nothing else moving.
   */
  const AURORA_DRIFT_MS = 20_000;
  const atlas = document.querySelector<HTMLElement>('.launch-atlas-cta');
  if (atlas) {
    const driftThenRest = () =>
      window.setTimeout(
        () => atlas.classList.add('launch-atlas-cta--resting'),
        AURORA_DRIFT_MS,
      );
    if (document.visibilityState === 'visible') driftThenRest();
    else
      document.addEventListener('visibilitychange', driftThenRest, {
        once: true,
      });
  }
</script>
