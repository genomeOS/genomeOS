---
/**
 * How it works: the three steps (round 2 spec §4.1.4; R2-3, R2-7; #454; prototype
 * `r2/hp/proto/home.js` `steps`). A mechanism plate (kit Plate): mixed records ride in from
 * research papers, the community and partners, go through one harmonizing gate and leave as
 * identical white studs. Each measurement takes two lanes that never join (round 1 §6.1 rule 1, as
 * in the Pipeline): the measured lane carries it straight to the Atlas as a point, and a copy goes
 * into the model, whose estimates leave as teal hexes on the modeled lane. On the globe (the kit's
 * AtlasMark) the cells fill nearest a survey first, gaps stay hatched, and the visitor's cursor
 * arrives last. Abstract: no coastlines, no numbers.
 *
 *   wide  (≥ 64rem)       viewBox 1200 × 336, stages left to right, labels 17 units
 *   mid   (48–64rem)      the tall stage in 5 of 12 columns, the steps beside it, level with
 *                         their stages
 *   tall  (< 48rem)       viewBox 300 × 630, stages top to bottom, the steps under it
 *
 * Server-rendered at rest, so the figure is whole without JavaScript and under reduced motion.
 * how-it-works.ts (imported as the figure approaches) builds the moving parts and plays the 4.9 s
 * story once at 35% visible; Replay plays it again. The bottom bar is the three numbered steps
 * (h3s); the stage is an image named by one sentence.
 */
import AtlasMark from '../kit/AtlasMark.astro';
import Plate from '../kit/Plate.astro';
import SceneControls from '../kit/SceneControls.astro';
import BrandName from '../BrandName.astro';

interface Point {
  x: number;
  y: number;
}
interface Layout {
  name: 'wide' | 'tall';
  viewBox: string;
  width: number;
  height: number;
  socket: number;
  iconScale: number;
  sources: Point[];
  /** Label lines under each socket, and the first line's baseline below the socket's centre. */
  labels: string[][];
  labelDy: number;
  inWire: (source: Point, index: number) => string;
  gate: { x: number; y: number; w: number; h: number };
  toModel: string;
  measured: string;
  modeled: string;
  model: { x: number; y: number; w: number; h: number };
  layers: Point[][];
  nodeR: number;
  globe: { x: number; y: number; size: number };
  cursor: Point;
}

const WIDE: Layout = {
  name: 'wide',
  viewBox: '0 40 1200 336',
  width: 1200,
  height: 336,
  socket: 60,
  iconScale: 1,
  sources: [92, 200, 308].map((y) => ({ x: 76, y })),
  labels: [['Research papers'], ['Community'], ['Partners']],
  labelDy: 54,
  inWire: (s, i) =>
    `M106 ${s.y} C 230 ${s.y}, 240 ${200 + (i - 1) * 14}, 338 ${200 + (i - 1) * 14}`,
  gate: { x: 338, y: 140, w: 16, h: 120 },
  toModel: 'M354 200 L520 200',
  measured:
    'M354 200 C430 200, 420 58, 520 58 L880 58 C940 58, 952 104, 956 128',
  modeled: 'M680 200 C800 200, 850 236, 928 236',
  model: { x: 520, y: 120, w: 160, h: 160 },
  layers: [
    [170, 200, 230],
    [155, 185, 215, 245],
    [170, 200, 230],
  ].map((ys, k) => ys.map((y) => ({ x: 556 + k * 44, y }))),
  nodeR: 6,
  globe: { x: 920, y: 90, size: 220 },
  cursor: { x: 1076, y: 252 },
};

const TALL: Layout = {
  name: 'tall',
  viewBox: '0 0 300 630',
  width: 300,
  height: 630,
  socket: 52,
  iconScale: 0.86,
  sources: [50, 150, 250].map((x) => ({ x, y: 36 })),
  labels: [['Research', 'papers'], ['Community'], ['Partners']],
  labelDy: 50,
  inWire: (s, i) =>
    `M${s.x} 114 C ${s.x} 130, ${150 + (i - 1) * 12} 126, ${150 + (i - 1) * 12} 142`,
  gate: { x: 96, y: 142, w: 108, h: 14 },
  toModel: 'M150 156 L150 206',
  measured:
    'M150 156 C150 184, 282 176, 282 218 L282 404 C282 440, 252 450, 216 456',
  modeled: 'M150 318 C150 366, 128 384, 130 430',
  model: { x: 94, y: 206, w: 112, h: 112 },
  layers: [
    [122, 150, 178],
    [108, 136, 164, 192],
    [122, 150, 178],
  ].map((xs, k) => xs.map((x) => ({ x, y: 236 + k * 26 }))),
  nodeR: 5,
  globe: { x: 53, y: 423, size: 194 },
  cursor: { x: 190, y: 566 },
};

/** Source icons, drawn for a 60-unit socket and centred at the origin (prototype `ICONS`). */
const ICONS = [
  // a paper with an AI spark
  'M-12 -14h17l7 7v21h-24Z M5 -14v7h7 M-7 -2h12 M-7 4h12 M-7 10h8 M13 -19l1.6 4 4 1.6-4 1.6L13 -8l-1.6-3.8-4-1.6 4-1.6Z',
  // three people
  'M-9 -6a5 5 0 1 0 0.01 0Z M9 -6a5 5 0 1 0 0.01 0Z M0 -12a5.5 5.5 0 1 0 0.01 0Z M-17 12c1-6 4-9 8-9 M17 12c-1-6-4-9-8-9 M-8 13c1-7 4-10 8-10s7 3 8 10',
  // a partner institution
  'M-14 13h28 M-12 -4h24 M0 -15l14 8h-28Z M-9 -1v11 M-3 -1v11 M3 -1v11 M9 -1v11',
];
const CURSOR = 'M0 0 L0 17 L4.5 13 L8 20 L10.5 19 L7 12 L13 12 Z';

const edges = (layers: Point[][]) =>
  [0, 1].map((k) =>
    layers[k].flatMap((a) => layers[k + 1].map((b) => ({ a, b }))),
  );

const label =
  'Records from research papers, the community and partners are put into one format. The measurements go straight to the Atlas as points, and separately into AI models whose estimates arrive as a colored surface.';
---

<Plate graphic="how-it-works" label={label} class="hiw">
  <SceneControls slot="top" object="the three steps" replay />
  {
    [WIDE, TALL].map((layout) => (
      <svg
        class="hiw-svg"
        data-layout={layout.name}
        viewBox={layout.viewBox}
        width={layout.width}
        height={layout.height}
        aria-hidden="true"
        focusable="false"
      >
        <g class="hiw-in" data-direction={layout.name === 'wide' ? 'x' : 'y'}>
          {layout.sources.map((source, index) => (
            <path
              class="hiw-wire hiw-wire--in"
              d={layout.inWire(source, index)}
              data-wire={`in${index}`}
            />
          ))}
        </g>
        <path
          class="hiw-wire hiw-wire--measured"
          d={layout.toModel}
          data-wire="to-model"
        />
        <path
          class="hiw-wire hiw-wire--measured"
          d={layout.measured}
          data-wire="measured"
        />
        <path
          class="hiw-wire hiw-wire--modeled"
          d={layout.modeled}
          data-wire="modeled"
        />
        {layout.sources.map((source, index) => (
          <g class="hiw-source">
            <rect
              class="hiw-socket"
              x={source.x - layout.socket / 2}
              y={source.y - layout.socket / 2}
              width={layout.socket}
              height={layout.socket}
            />
            <path
              class="hiw-icon"
              d={ICONS[index]}
              transform={`translate(${source.x} ${source.y}) scale(${layout.iconScale})`}
            />
            <text
              class="hiw-label"
              x={source.x}
              y={source.y + layout.labelDy}
              text-anchor="middle"
            >
              {layout.labels[index].map((line, row) => (
                <tspan x={source.x} dy={row ? '1.12em' : undefined}>
                  {line}
                </tspan>
              ))}
            </text>
          </g>
        ))}
        <rect
          class="hiw-gate"
          x={layout.gate.x}
          y={layout.gate.y}
          width={layout.gate.w}
          height={layout.gate.h}
        />
        <rect
          class="hiw-socket hiw-model"
          x={layout.model.x}
          y={layout.model.y}
          width={layout.model.w}
          height={layout.model.h}
        />
        {edges(layout.layers).map((pairs, k) => (
          <g class="hiw-edges" data-layer={k}>
            {pairs.map(({ a, b }) => (
              <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />
            ))}
          </g>
        ))}
        {layout.layers.map((nodes, k) => (
          <g class="hiw-nodes" data-layer={k}>
            {nodes.map((node) => (
              <circle cx={node.x} cy={node.y} r={layout.nodeR} />
            ))}
          </g>
        ))}
        <AtlasMark
          size={String(layout.globe.size)}
          variant="stage"
          x={layout.globe.x}
          y={layout.globe.y}
          idPrefix={`hiw-${layout.name}`}
        />
        <path
          class="hiw-cursor"
          d={CURSOR}
          transform={`translate(${layout.cursor.x} ${layout.cursor.y})`}
          data-x={layout.cursor.x}
          data-y={layout.cursor.y}
        />
        <g class="hiw-tokens" />
      </svg>
    ))
  }
  <ol slot="caption" class="hiw-steps">
    <li class="hiw-step" data-step="1">
      <h3><span>Gather and harmonize</span></h3>
      <p>
        We collect genetic data from research papers and our community, welcome
        university and industry partners, and put it into one format. AI agents
        that read the research are coming.
      </p>
    </li>
    <li class="hiw-step" data-step="2">
      <h3><span>Build AI models</span></h3>
      <p>
        Models learn from real measurements to estimate what hasn’t been
        measured yet, and show how sure they are.
      </p>
    </li>
    <li class="hiw-step" data-step="3">
      <h3><span>Explore the <BrandName /> Atlas</span></h3>
      <p>Anyone can see the results on a free, interactive globe.</p>
    </li>
  </ol>
</Plate>
