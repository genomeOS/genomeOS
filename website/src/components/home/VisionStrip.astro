---
/**
 * The larger vision, as a teaser (site redesign spec §4.1 H6; #454): Project's scale ladder at
 * teaser scale. The same four frames (kit/scale-frames.ts: a value-free land footprint on a globe,
 * an abstract cluster of studs, chromosome 11 with the HBB tick, a cell nucleus) joined by the same
 * zoom wedges, each opening from a zoom box on the content it magnifies into the next frame.
 * Earth and population are drawn solid with an ion "In active development" dot; chromosome 11 and
 * the cell are violet dashed outlines with a "Future exploration" dot, the only way future work is
 * drawn (spec §6.1 rule 7). Its studs and footprint look like data but hold none, so it is tagged
 * "Schematic" (spec §2.6). The frames fade in left to right once (CSS, home.css); the page links
 * on to the Project's full ladder.
 *
 * Design review, round 2: the teaser had drawn its own 40 px glyphs in 150 px frames, with each
 * zoom square on the frame's right edge, so its wedges read as connectors, not magnification.
 *
 * Two layouts, chosen by a container query, each with labels at 13 px or more where it is used:
 *   row   (stage ≥ 600 px)  the four frames left to right, at most 760 px wide
 *   grid  (narrower)        a 2 × 2 "U", as on Project's phone ladder: Earth → Population across the
 *                           top, down to Chromosome 11, back across the bottom to Cell
 */
import StatusTag from '../kit/StatusTag.astro';
import {
  FRAME,
  FRAME_ORDER,
  WEDGES,
  frameArt,
  isFutureFrame,
  zoomWedge,
  type FrameKey,
  type Placement,
} from '../kit/scale-frames';
import '../../styles/scale-frames.css';

interface Layout {
  key: 'row' | 'grid';
  viewBox: readonly [number, number, number, number];
  font: number;
  frames: Record<FrameKey, Placement>;
  labels: Record<FrameKey, { x: number; y: number }>;
}

const ROW_FRAME = 124;
const ROW_GAP = 64;
const row = (index: number) => 1 + index * (ROW_FRAME + ROW_GAP);
const GRID_FRAME = 120;
const LAYOUTS: Layout[] = [
  {
    key: 'row',
    viewBox: [0, 0, 690, 158],
    font: 15,
    frames: Object.fromEntries(
      FRAME_ORDER.map((frame, index) => [
        frame,
        { x: row(index), y: 1, scale: ROW_FRAME / FRAME },
      ]),
    ) as Record<FrameKey, Placement>,
    labels: Object.fromEntries(
      FRAME_ORDER.map((frame, index) => [
        frame,
        { x: row(index) + ROW_FRAME / 2, y: 148 },
      ]),
    ) as Record<FrameKey, { x: number; y: number }>,
  },
  {
    key: 'grid',
    viewBox: [0, 0, 300, 348],
    font: 15,
    frames: {
      earth: { x: 12, y: 30, scale: GRID_FRAME / FRAME },
      population: { x: 168, y: 30, scale: GRID_FRAME / FRAME },
      chromosome: { x: 168, y: 196, scale: GRID_FRAME / FRAME },
      nucleus: { x: 12, y: 196, scale: GRID_FRAME / FRAME },
    },
    labels: {
      earth: { x: 72, y: 20 },
      population: { x: 228, y: 20 },
      chromosome: { x: 228, y: 338 },
      nucleus: { x: 72, y: 338 },
    },
  },
];

const LABEL: Record<FrameKey, string> = {
  earth: 'Earth',
  population: 'Population',
  chromosome: 'Chromosome 11',
  nucleus: 'Cell',
};
const art = (layout: Layout) => frameArt(`vs-clip-${layout.key}`);
// Home's one island, in src/pages/index.astro, starts this figure with a FigureController.
---

<figure class="vs" data-graphic="vision" data-kind="mechanism">
  <div class="vs-toolbar" data-figure-chrome>
    <StatusTag kind="schematic" />
  </div>
  <div
    class="vs-stage"
    data-figure-stage
    role="img"
    aria-label="Four scales, from Earth to a cell. Only the Earth and population scales are in development."
  >
    {
      LAYOUTS.map((layout) => {
        const drawn = art(layout);
        return (
          <svg
            class:list={['vs-svg', `vs-svg--${layout.key}`]}
            viewBox={layout.viewBox.join(' ')}
            aria-hidden="true"
            focusable="false"
          >
            <g class="vs-wedges">
              {WEDGES.map(([from, to], index) => (
                <g
                  class:list={[
                    'vs-wedge',
                    'ladder__wedge',
                    { 'ladder__wedge--future': isFutureFrame(to) },
                  ]}
                  data-wedge={index + 1}
                  style={`--k: ${index + 1}`}
                >
                  {zoomWedge(layout.frames, from, to).map(
                    ([x1, y1, x2, y2]) => (
                      <line
                        x1={x1.toFixed(1)}
                        y1={y1.toFixed(1)}
                        x2={x2.toFixed(1)}
                        y2={y2.toFixed(1)}
                      />
                    ),
                  )}
                </g>
              ))}
            </g>
            {FRAME_ORDER.map((frame, index) => {
              const { x, y, scale } = layout.frames[frame];
              const future = isFutureFrame(frame);
              return (
                <g
                  class:list={['vs-frame', { 'ladder__frame--future': future }]}
                  data-frame={frame}
                  style={`--k: ${index}`}
                >
                  <g
                    class="ladder__art"
                    transform={`translate(${x} ${y}) scale(${scale.toFixed(4)})`}
                  >
                    <rect
                      class="ladder__border"
                      x="0"
                      y="0"
                      width={FRAME}
                      height={FRAME}
                    />
                    <g set:html={drawn[frame]} />
                    <circle
                      class="vs-dot"
                      data-status={future ? 'future' : 'active'}
                      cx="16"
                      cy="16"
                      r="6"
                    />
                  </g>
                  <text
                    class="ladder__label"
                    x={layout.labels[frame].x}
                    y={layout.labels[frame].y}
                    font-size={layout.font}
                    text-anchor="middle"
                  >
                    {LABEL[frame]}
                  </text>
                </g>
              );
            })}
          </svg>
        );
      })
    }
  </div>
  <figcaption class="vs-legend" data-figure-chrome>
    <span class="vs-status" data-status="active">In active development</span>
    <span class="vs-status" data-status="future">Future exploration</span>
  </figcaption>
</figure>
