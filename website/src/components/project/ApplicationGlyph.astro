---
/**
 * The six application glyphs (site redesign spec §4.1 H5; #454): 96×64 drawings in the Atlas's own
 * marks, with no numbers. Each one's resting drawing is its end state; the card's CSS plays its
 * mechanism once on hover (≤ 1.2 s) and draws it in on reveal (applications.css).
 *
 * Design review, round 3: the drawings filled about 60% of their 96 × 64 box and read small. Each
 * viewBox is now the 84 × 48 band every drawing fits in (y 8–56), starting at its own drawing's
 * left edge, and applications.css draws them all at one scale (×1.69, 4.5rem tall: a step of the spacing
 * scale), so a drawing stands on the card's text edge at about 128 × 80 and every glyph's marks and
 * strokes keep one size.
 *
 *   1 screening    a hex cluster; a threshold line sweeps down and the cells above it are outlined
 *   2 diagnostic   one survey stud and a range bar with its tick
 *   3 trial        count dots gather until a target ring closes
 *   4 unknown      a hatched patch; a stud lands and its neighbours turn from hatch to colour
 *   5 medicines    two allele dots in a hex pair, one changing (future: violet dashed outlines)
 *   6 discovery    two overlapping contours whose intersection lights
 *
 * Decorative (aria-hidden): the card's words carry the meaning.
 */
import { ENC, STUD_RADIUS } from '../../graphics/encoding';
import { cssVarStyles, studSvg } from '../kit/svg';

interface Props {
  variant: 1 | 2 | 3 | 4 | 5 | 6;
}

const { variant } = Astro.props;

/** The band of the 96 × 64 box that every drawing fits in, strokes included. */
const BAND = { top: 8, width: 84, height: 48 };
/** Each drawing's left edge in its 96-unit box (strokes included); the viewBox starts there. */
const LEFT: Record<Props['variant'], number> = {
  1: 7,
  2: 10,
  3: 30,
  4: 14,
  5: 22,
  6: 15,
};

// Pointy-top hexagon of radius r centred on (cx, cy).
const hex = (cx: number, cy: number, r: number) =>
  Array.from({ length: 6 }, (_, k) => {
    const a = (Math.PI / 3) * k - Math.PI / 2;
    return `${k ? 'L' : 'M'}${(cx + r * Math.cos(a)).toFixed(2)} ${(cy + r * Math.sin(a)).toFixed(2)}`;
  }).join('') + 'Z';
const W = 9 * Math.sqrt(3); // pointy-top width at r = 9
const cell = (col: number, row: number, x0 = 24, y0 = 14) =>
  [x0 + col * W + (row % 2 ? W / 2 : 0), y0 + row * 13.5] as const;
const stud = (x: number, y: number, r = STUD_RADIUS.lg) => studSvg(x, y, r);
const hatchId = `ag-hatch-${variant}`;
const hatch = `<pattern id="${hatchId}" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="5" height="5" fill="var(--enc-land)"/><path d="M2.5 0V5" stroke="var(--enc-hatch)" stroke-opacity="${ENC.hatchAlpha}" stroke-width="${ENC.hatchWidth}"/></pattern>`;

let body = '';
if (variant === 1) {
  // Ordered by value, highest at the top: the threshold line settles under the top row, and the
  // cells above it are outlined.
  const cells: [number, number, string, boolean][] = [
    [0.5, 0, 'var(--enc-mean-6)', true],
    [1.5, 0, 'var(--enc-mean-5)', true],
    [2.5, 0, 'var(--enc-mean-6)', true],
    [0, 1, 'var(--enc-mean-3)', false],
    [1, 1, 'var(--enc-mean-4)', false],
    [2, 1, 'var(--enc-mean-3)', false],
    [3, 1, 'var(--enc-mean-2)', false],
    [0.5, 2, 'var(--enc-mean-1)', false],
    [1.5, 2, 'var(--enc-mean-2)', false],
    [2.5, 2, 'var(--enc-mean-1)', false],
  ];
  const at = (col: number, row: number) => cell(col, row, 24, 18);
  body =
    cells
      .map(([col, row, fill]) => {
        const [x, y] = at(col, row);
        return `<path d="${hex(x, y, 8.4)}" fill="${fill}"/>`;
      })
      .join('') +
    cells
      .filter(([, , , above]) => above)
      .map(([col, row], index) => {
        const [x, y] = at(col, row);
        // One style attribute: cssVarStyles would add a second for a var() attribute.
        return `<path class="ag-above" style="--k:${index};stroke:var(--color-ion)" d="${hex(x, y, 8.4)}" fill="none" stroke-width="1.4"/>`;
      })
      .join('') +
    `<path class="ag-sweep" d="M8 24.75H88" stroke="var(--color-starlight)" stroke-width="1.2" stroke-dasharray="3 2.5"/>`;
} else if (variant === 2) {
  body =
    `<circle cx="22" cy="32" r="11" fill="none" stroke="var(--enc-obs-radius)" stroke-dasharray="2 2"/>` +
    stud(22, 32) +
    `<path d="M44 32H88" stroke="rgb(165 185 211 / 35%)" stroke-width="1"/>` +
    `<rect class="ag-range" x="52" y="28.5" width="26" height="7" fill="var(--enc-mean-4)"/>` +
    `<path d="M63 25v14" stroke="var(--color-starlight)" stroke-width="1.6"/>`;
} else if (variant === 3) {
  const dots: [number, number, number, number][] = [
    [40, 26, -22, -12],
    [48, 24, 18, -14],
    [55, 30, 24, 6],
    [44, 36, -20, 14],
    [52, 38, 10, 18],
    [47, 31, -6, -18],
    [58, 22, 22, -8],
    [38, 32, -24, 2],
  ];
  body =
    `<circle class="ag-ring" cx="48" cy="31" r="17" fill="none" stroke="var(--color-starlight)" stroke-width="1.2" pathLength="1"/>` +
    dots
      .map(
        ([x, y, dx, dy], index) =>
          `<g class="ag-dot" style="--dx:${dx}px;--dy:${dy}px;--k:${index}">${studSvg(x, y, STUD_RADIUS.sm)}</g>`,
      )
      .join('');
} else if (variant === 4) {
  const patch: [number, number, boolean][] = [
    [0, 0, false],
    [1, 0, true],
    [2, 0, true],
    [3, 0, false],
    [0.5, 1, true],
    [1.5, 1, true],
    [2.5, 1, true],
    [0, 2, false],
    [1, 2, true],
    [2, 2, true],
    [3, 2, false],
  ];
  const fills = [
    'var(--enc-mean-4)',
    'var(--enc-mean-5)',
    'var(--enc-mean-partial-2)',
  ];
  body =
    `<defs>${hatch}</defs>` +
    patch
      .map(([col, row]) => {
        const [x, y] = cell(col, row, 22, 18);
        return `<path d="${hex(x, y, 8.4)}" fill="url(#${hatchId})"/>`;
      })
      .join('') +
    patch
      .filter(([, , near]) => near)
      .map(([col, row], index) => {
        const [x, y] = cell(col, row, 22, 18);
        return `<path class="ag-fill" style="--k:${index};fill:${fills[index % fills.length]}" d="${hex(x, y, 8.4)}"/>`;
      })
      .join('') +
    `<g class="ag-stud">${stud(cell(1.5, 1, 22, 18)[0], cell(1.5, 1, 22, 18)[1])}</g>`;
} else if (variant === 5) {
  const left = hex(36, 32, 15);
  const right = hex(36 + 15 * Math.sqrt(3), 32, 15);
  body =
    `<path d="${left}" fill="none" stroke="var(--color-genome)" stroke-width="1.3" stroke-dasharray="3 2.5"/>` +
    `<path d="${right}" fill="none" stroke="var(--color-genome)" stroke-width="1.3" stroke-dasharray="3 2.5"/>` +
    `<circle cx="36" cy="32" r="4.5" fill="var(--color-starlight)"/>` +
    `<circle class="ag-allele-was" cx="${(36 + 15 * Math.sqrt(3)).toFixed(2)}" cy="32" r="4.5" fill="var(--color-starlight)"/>` +
    `<circle class="ag-allele-now" cx="${(36 + 15 * Math.sqrt(3)).toFixed(2)}" cy="32" r="4" fill="none" stroke="var(--color-genome)" stroke-width="1.8"/>`;
} else {
  body =
    `<defs><clipPath id="ag-clip-6"><ellipse cx="38" cy="32" rx="22" ry="16"/></clipPath></defs>` +
    `<ellipse class="ag-intersect" cx="58" cy="32" rx="22" ry="16" clip-path="url(#ag-clip-6)" fill="rgb(112 230 255 / 26%)"/>` +
    `<ellipse class="ag-contour" cx="38" cy="32" rx="22" ry="16" fill="none" stroke="var(--color-muted)" stroke-width="1.2" pathLength="1"/>` +
    `<ellipse class="ag-contour" cx="58" cy="32" rx="22" ry="16" fill="none" stroke="var(--color-starlight)" stroke-width="1.2" stroke-dasharray="3 2.5"/>` +
    `<ellipse cx="38" cy="32" rx="12" ry="8" fill="none" stroke="var(--color-muted)" stroke-opacity=".55" stroke-width="1"/>` +
    `<ellipse cx="58" cy="32" rx="12" ry="8" fill="none" stroke="var(--color-starlight)" stroke-opacity=".55" stroke-width="1" stroke-dasharray="3 2.5"/>`;
}
---

<svg
  class:list={['ag', `ag--${variant}`]}
  viewBox={`${LEFT[variant]} ${BAND.top} ${BAND.width} ${BAND.height}`}
  width={BAND.width}
  height={BAND.height}
  aria-hidden="true"
  focusable="false"
  set:html={cssVarStyles(body)}
/>
