---
/**
 * One potential application (site redesign spec §4.1 H5; round 2 spec §4.2.3; #454): its glyph,
 * title, horizon and one line. The horizon is words with a status dot (aurora: first release; ion:
 * active study, output or hypothesis; genome: future), never colour alone, and only where a status
 * applies (round 2: optional, so cards 3, 4 and 6 have none). A horizon is a status, never a
 * limitation: ruling 59 retired the gold chip that said a use still needed clinical checks.
 * On Projects the title is an h4 under the section's h3 (`level`). The `.application-card` class,
 * its reveal and the hover lift stay (tests pin them).
 */
import ApplicationGlyph from './ApplicationGlyph.astro';
import './applications.css';

interface Props {
  index: number;
  title: string;
  horizon?: string;
  tone?: 'aurora' | 'ion' | 'genome';
  /** The title's heading level: 3 under a page's h2, 4 under a section's h3 (Projects). */
  level?: 3 | 4;
  line: string;
  glyph: 1 | 2 | 3 | 4 | 5 | 6;
}

const { index, title, horizon, tone, line, glyph, level = 3 } = Astro.props;
const Title = level === 4 ? 'h4' : 'h3';
---

<article
  class="application-card"
  data-reveal
  style={`--reveal-delay: ${Math.min(index * 70, 280)}ms; --i: ${index}`}
>
  <ApplicationGlyph variant={glyph} />
  <Title class="application-card__title">{title}</Title>
  {
    horizon && (
      <p class="application-card__horizon" data-tone={tone}>
        {horizon}
      </p>
    )
  }
  <p class="application-card__line">{line}</p>
</article>
