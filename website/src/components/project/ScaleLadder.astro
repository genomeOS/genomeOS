---
/**
 * The multi-scale vision (site redesign spec §4.2, the vision, #454): the scale ladder, four frames joined
 * by zoom wedges (a small region in one frame expands into the next), with the three levels of the
 * vision as a tablist. It replaces the three generated vision images.
 *
 *   Earth            a value-free land footprint on a globe: no data, no coastline
 *   Population       an abstract cluster of studs with their stated radius rings
 *   Chromosome 11    an ideogram with the HBB gene marked at 11p15.4         (future, violet dashed)
 *   Cell nucleus     an outline with chromatin and the folded locus           (future, violet dashed)
 *   the bridge       from the HBB tick back to the population it was measured in (future)
 *
 * Its studs and footprint look like data but hold none, so the figure is tagged "Schematic" (spec
 * §2.6). The selected tab lights its frames (1–2, 3–4, or the bridge); the art of the rest dims, the
 * labels never do. Its one-line panel is the figure's caption. Server-rendered at rest in both
 * layouts (ladder.ts); a container query picks the row or the 2 × 2 grid. The page's island
 * (project.astro) calls `initLadder`.
 */
import StatusTag from '../kit/StatusTag.astro';
import {
  FRAME,
  FRAME_ORDER,
  WEDGES,
  frameArt,
  isFutureFrame,
  type FrameKey,
} from '../kit/scale-frames';
import '../../styles/scale-frames.css';
import { LAYOUTS, wedge, type Layout, type Level } from './ladder';

interface Props {
  idPrefix?: string;
}

const { idPrefix = 'ladder' } = Astro.props;
const id = (suffix: string) => `${idPrefix}-${suffix}`;

const TABS: {
  level: Level;
  title: string;
  status: 'active' | 'future';
  statusLabel: string;
  panel: string;
  stageLabel: string;
}[] = [
  {
    level: 'earth',
    title: 'Variation across Earth',
    status: 'active',
    statusLabel: 'In active development',
    panel: 'Where variants and conditions are common, rare or unmeasured.',
    stageLabel:
      'Four scales, from Earth to a cell nucleus. Lit: Earth and a population, the two scales in active development.',
  },
  {
    level: 'cell',
    title: 'The genome inside the cell',
    status: 'future',
    statusLabel: 'Future exploration',
    panel: 'From chromosome to the folded locus around a gene.',
    stageLabel:
      'Four scales, from Earth to a cell nucleus. Lit, as future exploration: chromosome 11 with the HBB gene at 11p15.4, and the folded locus inside a cell nucleus.',
  },
  {
    level: 'bridge',
    title: 'The bridge',
    status: 'future',
    statusLabel: 'Future exploration',
    panel: 'Linking where a variant is found to what it does.',
    stageLabel:
      'Four scales, from Earth to a cell nucleus. Lit, as future exploration: a bridge from the HBB gene on chromosome 11 back to the population where its variant was measured.',
  },
];

const LABEL: Record<FrameKey, string> = {
  earth: 'Earth',
  population: 'Population',
  chromosome: 'Chromosome 11',
  nucleus: 'Cell nucleus',
};

const layouts: Layout[] = ['row', 'grid'];
const svgFor = (layout: Layout) => {
  const geometry = LAYOUTS[layout];
  // The frame art (kit/scale-frames.ts), with a unique id per layout for the chromosome's clip.
  const drawn = frameArt(id(`clip-${layout}`));
  const art = (frame: FrameKey) => drawn[frame];
  return { geometry, art };
};
---

<figure
  class="ladder"
  data-graphic="scale-ladder"
  data-level="earth"
  data-ladder
>
  <div class="ladder__tabs">
    <div
      class="ladder__tablist"
      role="tablist"
      aria-label="Levels of the vision"
      data-figure-chrome
    >
      {
        TABS.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={id(`tab-${tab.level}`)}
            aria-controls={id(`panel-${tab.level}`)}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-level={tab.level}
            data-stage-label={tab.stageLabel}
          >
            <span class="ladder__tab-title">{tab.title}</span>
            <span class="ladder__tab-status" data-status={tab.status}>
              {tab.statusLabel}
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="ladder__toolbar" data-figure-chrome>
    <StatusTag kind="schematic" />
  </div>

  <div
    class="ladder__stage"
    data-figure-stage
    role="img"
    aria-label={TABS[0].stageLabel}
  >
    {
      layouts.map((layout) => {
        const { geometry, art } = svgFor(layout);
        return (
          <svg
            class:list={['ladder__svg', `ladder__svg--${layout}`]}
            viewBox={geometry.viewBox.join(' ')}
            aria-hidden="true"
          >
            <g class="ladder__wedges">
              {WEDGES.map(([from, to], index) => {
                const lines = wedge(layout, from, to);
                return (
                  <g
                    class:list={[
                      'ladder__wedge',
                      { 'ladder__wedge--future': isFutureFrame(to) },
                    ]}
                    data-wedge={index + 1}
                    style={`--d: ${index * 300 + 220}`}
                  >
                    {lines.map(([x1, y1, x2, y2]) => (
                      <line
                        x1={x1.toFixed(1)}
                        y1={y1.toFixed(1)}
                        x2={x2.toFixed(1)}
                        y2={y2.toFixed(1)}
                        style={`transform-origin: ${x1.toFixed(1)}px ${y1.toFixed(1)}px`}
                      />
                    ))}
                  </g>
                );
              })}
            </g>
            {FRAME_ORDER.map((frame, index) => {
              const { x, y, scale } = geometry.frames[frame];
              return (
                <g
                  class:list={[
                    'ladder__frame',
                    { 'ladder__frame--future': isFutureFrame(frame) },
                  ]}
                  data-frame={frame}
                  style={`--d: ${index * 300}`}
                >
                  <g
                    class="ladder__art"
                    transform={`translate(${x} ${y}) scale(${scale.toFixed(4)})`}
                  >
                    <rect
                      class="ladder__border"
                      x="0"
                      y="0"
                      width={FRAME}
                      height={FRAME}
                    />
                    <g set:html={art(frame)} />
                  </g>
                </g>
              );
            })}
            <path class="ladder__bridge" d={geometry.bridge} style="--d: 950" />
            <g class="ladder__labels" font-size={geometry.font}>
              {FRAME_ORDER.map((frame, index) => (
                <text
                  class="ladder__label"
                  x={geometry.labels[frame].x}
                  y={geometry.labels[frame].y}
                  text-anchor="middle"
                  style={`--d: ${index * 300}`}
                >
                  {LABEL[frame]}
                  {frame === 'chromosome' && (
                    <tspan
                      class="ladder__label-sub"
                      x={geometry.labels[frame].x}
                      dy={geometry.font * 1.2}
                    >
                      HBB, 11p15.4
                    </tspan>
                  )}
                </text>
              ))}
            </g>
          </svg>
        );
      })
    }
  </div>

  <figcaption class="ladder__caption" data-figure-chrome>
    {
      TABS.map((tab, index) => (
        <p
          role="tabpanel"
          id={id(`panel-${tab.level}`)}
          aria-labelledby={id(`tab-${tab.level}`)}
          hidden={index !== 0}
        >
          {tab.panel}
        </p>
      ))
    }
  </figcaption>
</figure>
