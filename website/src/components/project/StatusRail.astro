---
/**
 * What exists, and what comes later (site redesign spec §4.2, status, §6.1 rule 7; round 2 spec
 * §4.2.9; #454): the evidence totals, then a roadmap rail in three zones. Available now is solid
 * aurora, In active development ion with gaps, Future exploration violet dashed. One node per item
 * sits on the rail; a gold gate diamond (the validation gate) stands between what is available now
 * and the rest. Round 2: no status tag on the Atlas item (R2-14; the gate and "Validation against
 * published estimates" say where validation stands), "Agentic literature search" names the owner's
 * step 1, and Home's evidence totals head the figure, with their definition behind "How we count".
 *
 * The totals are static text from the pinned corpus revision (src/data/corpusMetrics.ts), so a
 * total never reads as zero on screen, in a screenshot or to a screen reader; the people total
 * keeps "not deduplicated" in sight. The lists are the content; the rail and its nodes are
 * aria-hidden. Hovering an item lights its node, and the reverse; a tap keeps the pair lit until the
 * next tap. The marker count comes from the catalog `/app/` inlines, so it is never typed by hand.
 * Horizontal on wide screens; on a phone the rail runs down the lists. The page's island
 * (projects.astro) plays the entrance and links items to nodes. The section's h3 names the figure
 * (`titleId`); the zone titles are h4s.
 */
import { corpusMetrics, metricTotal } from '../../data/corpusMetrics';
import { loadPageCatalog } from '../../lib/catalog-build';

interface Props {
  titleId?: string;
}

const { titleId = 'status-title' } = Astro.props;
const { catalog } = loadPageCatalog(process.env.ATLAS_CATALOG_PATH);
const markers = catalog.artifacts.length;

const int = (value: number) => value.toLocaleString('en-US');
const millions = (value: number) => `${(value / 1e6).toFixed(2)}M`;
const { variants, people, diseases } = corpusMetrics;
const TOTALS = [
  {
    value: metricTotal(variants),
    shown: int(metricTotal(variants)),
    label: 'Genetic variants & alleles',
  },
  {
    value: metricTotal(people),
    shown: millions(metricTotal(people)),
    label: people.isDeduplicated
      ? 'People represented'
      : 'People represented, not deduplicated',
  },
  {
    value: metricTotal(diseases),
    shown: int(metricTotal(diseases)),
    label: 'Diseases represented',
  },
];

const ZONES: {
  key: 'now' | 'active' | 'future';
  title: string;
  items: string[];
}[] = [
  {
    key: 'now',
    title: 'Available now',
    items: [
      `The Atlas: observations and surfaces for ${markers} markers`,
      'Population registry and data tools',
    ],
  },
  {
    key: 'active',
    title: 'In active development',
    items: [
      'Agentic literature search',
      'Validation against published estimates',
      'More datasets',
      'Disease-burden layers',
      'Region tools',
    ],
  },
  {
    key: 'future',
    title: 'Future exploration',
    items: [
      'An agentic guide citing versioned evidence',
      'Opt-in personal genomes, behind privacy, consent and governance',
      'An ancient-DNA time slider',
      'A cellular atlas',
    ],
  },
];
// Node order for the entrance: zone by zone, 80 ms apart, each zone after its stretch of rail.
const SEGMENT_MS = 300;
---

<figure
  class="rail"
  data-graphic="status-rail"
  data-rail
  aria-labelledby={titleId}
>
  <figcaption class="rail__totals" data-figure-chrome>
    <ul class="rail__stats">
      {
        TOTALS.map((total) => (
          <li>
            <data value={total.value}>{total.shown}</data>
            <span>{total.label}</span>
          </li>
        ))
      }
    </ul>
    <details class="rail__method">
      <summary>How we count</summary>
      <div>
        <p>
          Variant total: {
            int(variants.components.afndAlleleIdentifiersAfterCurrentFilters)
          } identifiers from the <a href="https://www.allelefrequencies.net/"
            >Allele Frequency Net Database (AFND)</a
          > after the current quality filters, plus the hemoglobin S variant associated
          with sickle-cell disease (also known as HbS or rs334). Participant total:
          each retained database population sample counted once, plus people tested
          in the retained hemoglobin S surveys and male participants in the retained
          glucose-6-phosphate dehydrogenase (G6PD) deficiency surveys. Some studies
          may include overlapping groups, so this total describes the scale of the
          collected evidence rather than a verified census of unique individuals.
        </p>
        <p>
          Recomputed {corpusMetrics.countedAt} from source snapshot {
            corpusMetrics.sourceRevision
          }, last updated {corpusMetrics.sourceUpdatedAt}.
        </p>
      </div>
    </details>
  </figcaption>
  <div
    class="rail__stage"
    data-figure-stage
    role="group"
    aria-labelledby={titleId}
  >
    {
      ZONES.map((zone, zoneIndex) => (
        <div
          class:list={['rail__seg', `rail__seg--${zone.key}`]}
          style={`--d: ${zoneIndex * SEGMENT_MS}`}
          aria-hidden="true"
        >
          <span class="rail__line" />
          {zone.items.map((_item, index) => (
            <span
              class="rail__node"
              data-node={`${zone.key}-${index}`}
              style={`--x: ${((index + 0.5) / zone.items.length).toFixed(4)}; --d: ${zoneIndex * SEGMENT_MS + 120 + index * 80}`}
            />
          ))}
        </div>
      ))
    }
    {
      ZONES.map((zone, zoneIndex) => (
        <Fragment>
          {zoneIndex === 1 && (
            <span
              class="rail__gate"
              role="img"
              aria-label="Validation gate: published HbS, G6PD and carrier-screening results come first"
              style={`--d: ${SEGMENT_MS}`}
            />
          )}
          <div
            class:list={['rail__zone', `rail__zone--${zone.key}`]}
            style={`--d: ${zoneIndex * SEGMENT_MS}`}
          >
            <h4>{zone.title}</h4>
            <ul>
              {zone.items.map((item, index) => (
                <li
                  data-item={`${zone.key}-${index}`}
                  style={`--d: ${zoneIndex * SEGMENT_MS + 120 + index * 80}`}
                >
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </Fragment>
      ))
    }
  </div>
</figure>
