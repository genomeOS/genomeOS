---
/**
 * What exists, and what comes later (site redesign spec §4.2, status, §6.1 rule 7; #454): a roadmap
 * rail in three zones. Available now is solid aurora, In active development ion with gaps, Future
 * exploration violet dashed. One node per item sits on the rail; a gold gate diamond (the
 * validation gate) stands between what is available now and the rest, and the Atlas item carries
 * its "Not yet validated" tag.
 *
 * The lists are the content; the rail and its nodes are aria-hidden. Hovering an item lights its
 * node, and the reverse. The marker count comes from the catalog `/app/` inlines, so it is never
 * typed by hand. Horizontal on wide screens; on a phone the rail runs down the lists. The page's
 * island (project.astro) plays the entrance and links items to nodes.
 */
import { loadPageCatalog } from '../../lib/catalog-build';
import StatusTag from '../kit/StatusTag.astro';

interface Props {
  titleId?: string;
}

const { titleId = 'status-title' } = Astro.props;
const { catalog } = loadPageCatalog(process.env.ATLAS_CATALOG_PATH);
const markers = catalog.artifacts.length;

const ZONES: {
  key: 'now' | 'active' | 'future';
  title: string;
  items: { text: string; tag?: boolean }[];
}[] = [
  {
    key: 'now',
    title: 'Available now',
    items: [
      {
        text: `The Atlas: observations and surfaces for ${markers} markers`,
        tag: true,
      },
      { text: 'Population registry and data tools' },
    ],
  },
  {
    key: 'active',
    title: 'In active development',
    items: [
      { text: 'Literature evidence' },
      { text: 'Validation against published estimates' },
      { text: 'More datasets' },
      { text: 'Disease-burden layers' },
      { text: 'Region tools' },
    ],
  },
  {
    key: 'future',
    title: 'Future exploration',
    items: [
      { text: 'An agentic guide citing versioned evidence' },
      {
        text: 'Opt-in personal genomes, behind privacy, consent and governance',
      },
      { text: 'An ancient-DNA time slider' },
      { text: 'A cellular atlas' },
    ],
  },
];
// Node order for the entrance: zone by zone, 80 ms apart, each zone after its stretch of rail.
const SEGMENT_MS = 300;
---

<figure class="rail" data-graphic="status-rail" data-rail>
  <figcaption class="rail__caption">
    <h2 id={titleId}>What exists—and what comes later</h2>
  </figcaption>
  <div
    class="rail__stage"
    data-figure-stage
    role="group"
    aria-labelledby={titleId}
  >
    {
      ZONES.map((zone, zoneIndex) => (
        <div
          class:list={['rail__seg', `rail__seg--${zone.key}`]}
          style={`--d: ${zoneIndex * SEGMENT_MS}`}
          aria-hidden="true"
        >
          <span class="rail__line" />
          {zone.items.map((_item, index) => (
            <span
              class="rail__node"
              data-node={`${zone.key}-${index}`}
              style={`--x: ${((index + 0.5) / zone.items.length).toFixed(4)}; --d: ${zoneIndex * SEGMENT_MS + 120 + index * 80}`}
            />
          ))}
        </div>
      ))
    }
    {
      ZONES.map((zone, zoneIndex) => (
        <Fragment>
          {zoneIndex === 1 && (
            <span
              class="rail__gate"
              role="img"
              aria-label="Validation gate: published HbS, G6PD and carrier-screening results come first"
              style={`--d: ${SEGMENT_MS}`}
            />
          )}
          <div
            class:list={['rail__zone', `rail__zone--${zone.key}`]}
            style={`--d: ${zoneIndex * SEGMENT_MS}`}
          >
            <h3>{zone.title}</h3>
            <ul>
              {zone.items.map((item, index) => (
                <li
                  data-item={`${zone.key}-${index}`}
                  style={`--d: ${zoneIndex * SEGMENT_MS + 120 + index * 80}`}
                >
                  <span>{item.text}</span>
                  {item.tag && <StatusTag kind="not-validated" />}
                </li>
              ))}
            </ul>
          </div>
        </Fragment>
      ))
    }
  </div>
</figure>
