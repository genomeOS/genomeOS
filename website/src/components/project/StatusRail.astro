---
/**
 * Where it stands (site redesign spec §4.2, status, §6.1 rule 7; round 2 spec §4.2.9; #454): a
 * roadmap rail in three zones. Available now is solid aurora, In active development ion with gaps,
 * Future exploration violet dashed. One node per item sits on the rail; a gold gate diamond (the
 * validation gate) stands between what is available now and the rest. No status tag on the Atlas
 * item (R2-14). Since the owner's restructure (2026-10-15) the evidence totals and "How we count"
 * lead the chapter's overview (AtlasOverview.astro), and this rail is the "Where it stands"
 * section's one figure, behind its summary row.
 *
 * The lists are the content; the rail and its nodes are aria-hidden. Hovering an item lights its
 * node, and the reverse; a tap keeps the pair lit until the next tap. The count of variants and
 * alleles with maps comes from the catalog `/app/` inlines, so it is never typed by hand. It is in
 * the overview's unit ("Variants & alleles in the source tables"), so the two read together
 * (design critique 3: "markers" was a third unit, used nowhere else on the site). Horizontal on
 * wide screens; on a phone the rail runs down the lists. The section's module (section-status.ts) plays the entrance and
 * links items to nodes, once the section opens. The section's h3 names the figure (`titleId`); the
 * zone titles are h4s, and the visually hidden caption says what the rail shows.
 */
import { loadPageCatalog } from '../../lib/catalog-build';

interface Props {
  titleId?: string;
}

const { titleId = 'status-title' } = Astro.props;
const { catalog } = loadPageCatalog(process.env.ATLAS_CATALOG_PATH);
const mapped = catalog.artifacts.length;

const ZONES: {
  key: 'now' | 'active' | 'future';
  title: string;
  items: string[];
}[] = [
  {
    key: 'now',
    title: 'Available now',
    items: [
      `The Atlas: observations and surfaces for ${mapped} variants & alleles`,
      'Population registry and data tools',
    ],
  },
  {
    key: 'active',
    title: 'In active development',
    items: [
      'Agentic literature search',
      'Validation against published estimates',
      'More datasets',
      'Disease-burden layers',
      'Region tools',
    ],
  },
  {
    key: 'future',
    title: 'Future exploration',
    items: [
      'An agentic guide citing versioned evidence',
      'Opt-in personal genomes, behind privacy, consent and governance',
      'An ancient-DNA time slider',
      'A cellular atlas',
    ],
  },
];
// Node order for the entrance: zone by zone, 80 ms apart, each zone after its stretch of rail.
const SEGMENT_MS = 300;
---

<figure
  class="rail"
  data-graphic="status-rail"
  data-rail
  aria-labelledby={titleId}
>
  <figcaption class="visually-hidden">
    The <span class="brand-name">genomeOS</span> Atlas roadmap: what is available
    now, what is in active development, and what is for future exploration.
  </figcaption>
  <div
    class="rail__stage"
    data-figure-stage
    role="group"
    aria-labelledby={titleId}
  >
    {
      ZONES.map((zone, zoneIndex) => (
        <div
          class:list={['rail__seg', `rail__seg--${zone.key}`]}
          style={`--d: ${zoneIndex * SEGMENT_MS}`}
          aria-hidden="true"
        >
          <span class="rail__line" />
          {zone.items.map((_item, index) => (
            <span
              class="rail__node"
              data-node={`${zone.key}-${index}`}
              style={`--x: ${((index + 0.5) / zone.items.length).toFixed(4)}; --d: ${zoneIndex * SEGMENT_MS + 120 + index * 80}`}
            />
          ))}
        </div>
      ))
    }
    {
      ZONES.map((zone, zoneIndex) => (
        <Fragment>
          {zoneIndex === 1 && (
            <span
              class="rail__gate"
              role="img"
              aria-label="Validation gate: published HbS, G6PD and carrier-screening results come first"
              style={`--d: ${SEGMENT_MS}`}
            />
          )}
          <div
            class:list={['rail__zone', `rail__zone--${zone.key}`]}
            style={`--d: ${zoneIndex * SEGMENT_MS}`}
          >
            <h4>{zone.title}</h4>
            <ul>
              {zone.items.map((item, index) => (
                <li
                  data-item={`${zone.key}-${index}`}
                  style={`--d: ${zoneIndex * SEGMENT_MS + 120 + index * 80}`}
                >
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </Fragment>
      ))
    }
  </div>
</figure>
