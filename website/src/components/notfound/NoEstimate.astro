---
/**
 * The 404's figure (site redesign spec §4.6, plan Task 6; #454): this address is an unknown cell.
 * A seven-cell patch of model grid with no value drawn; the centre cell carries the hatch the
 * Atlas uses for "no estimate", the pinned outline and a crosshair; a readout on the end of the
 * crosshair's arm reads "No estimate", a dash where a number would be, and "This address has no
 * page." No numbers, no ramp colour, no script and no motion.
 *
 * It is an icon-scale diagram (spec §2.5): neither a data figure nor a mechanism plate, so no
 * frame and no `data-kind`. It is decorative (`aria-hidden`): the page's heading and lede say the
 * same thing in words. It still keeps the figure contract the cross-page suites read: one
 * `[data-figure-stage]`, a named stage and a figcaption, which is the readout.
 *
 * Marks follow the encoding tokens (spec §2.2): land `--enc-land`, the 45° hatch at the figures'
 * own pitch and width (`ENC`), the hexfield's pinned outline in ion. So the hatch stays 5 px
 * apart, each patch is drawn at 1 unit per CSS px, in two sizes: a large one beside the heading on
 * wide screens and a small one under the lede on phones.
 */
import Glyph from '../kit/Glyph.astro';
import { ENC } from '../../graphics/encoding';

const SQRT3 = Math.sqrt(3);
const round = (value: number) => Math.round(value * 100) / 100;

/** A flat-top hexagon (the kit glyphs' orientation) of circumradius r. */
const hexagon = (cx: number, cy: number, r: number) =>
  Array.from({ length: 6 }, (_, k) => {
    const angle = (Math.PI / 3) * k;
    return `${k ? 'L' : 'M'}${round(cx + r * Math.cos(angle))} ${round(cy + r * Math.sin(angle))}`;
  }).join('') + 'Z';

/** How far the crosshair runs past the patch, and its clearance around the centre cell. */
const MARGIN = 12;
const CLEAR = 6;
/** Half the void gap between neighbouring cells, taken off each cell's radius. */
const GAP = 1.25;

function patch(size: 'lg' | 'sm', radius: number) {
  const width = 5 * radius + 2 * MARGIN;
  const height = Math.ceil(3 * SQRT3 * radius) + 2 * MARGIN;
  const cx = width / 2;
  const cy = height / 2;
  const r = radius - GAP;
  // The centre, then its six neighbours across each edge.
  const neighbours = [30, 90, 150, 210, 270, 330].map((degrees) => {
    const angle = (degrees * Math.PI) / 180;
    return hexagon(
      cx + SQRT3 * radius * Math.cos(angle),
      cy + SQRT3 * radius * Math.sin(angle),
      r,
    );
  });
  const centre = hexagon(cx, cy, r);
  // Four arms out to the stage's edges, clear of the centre cell. The readout meets the right
  // arm's end (beside the patch) or the lower arm's end (under it, on the narrowest screens).
  const clearX = round(radius + CLEAR);
  const clearY = round((SQRT3 / 2) * radius + CLEAR);
  const arms =
    `M0 ${cy}H${round(cx - clearX)}M${round(cx + clearX)} ${cy}H${width}` +
    `M${cx} 0V${round(cy - clearY)}M${cx} ${round(cy + clearY)}V${height}`;
  return { size, width, height, neighbours, centre, arms };
}

const PATCHES = [patch('lg', 40), patch('sm', 26)];
const hatchId = (size: string) => `no-estimate-hatch-${size}`;
---

<figure class="no-estimate" data-graphic="no-estimate" aria-hidden="true">
  <div
    class="no-estimate__stage"
    data-figure-stage
    role="img"
    aria-label="A hatched map cell under a crosshair: no estimate."
  >
    {
      PATCHES.map(({ size, width, height, neighbours, centre, arms }) => (
        <svg
          class:list={['no-estimate__patch', `no-estimate__patch--${size}`]}
          data-patch={size}
          width={width}
          height={height}
          viewBox={`0 0 ${width} ${height}`}
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <pattern
              id={hatchId(size)}
              width={ENC.hatchPitch}
              height={ENC.hatchPitch}
              patternUnits="userSpaceOnUse"
              patternTransform="rotate(45)"
            >
              <path
                class="no-estimate__hatch-line"
                d={`M${ENC.hatchPitch / 2} 0V${ENC.hatchPitch}`}
                stroke-width={ENC.hatchWidth}
              />
            </pattern>
          </defs>
          <g data-cells>
            {neighbours.map((d) => (
              <path class="no-estimate__land" data-cell="land" d={d} />
            ))}
            <path class="no-estimate__land" data-cell="unknown" d={centre} />
          </g>
          <path data-hatch d={centre} fill={`url(#${hatchId(size)})`} />
          <path class="no-estimate__pin" d={centre} />
          <path class="no-estimate__crosshair" data-crosshair d={arms} />
        </svg>
      ))
    }
  </div>
  <figcaption class="no-estimate__readout" data-figure-chrome>
    <span class="no-estimate__kind"
      ><Glyph name="hatch" size={18} /> No estimate</span
    >
    <span class="no-estimate__value">—</span>
    <span class="no-estimate__note">This address has no page.</span>
  </figcaption>
</figure>

<style>
  .no-estimate {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    min-width: 0;
  }

  .no-estimate__stage {
    flex: none;
    line-height: 0;
  }

  .no-estimate__patch {
    display: block;
    overflow: visible;
  }

  .no-estimate__patch--lg {
    display: none;
  }

  /* From 68rem the heading's column leaves room for the large patch with the readout beside it. */
  @media (width >= 68rem) {
    .no-estimate__patch--lg {
      display: block;
    }

    .no-estimate__patch--sm {
      display: none;
    }
  }

  .no-estimate__land {
    fill: var(--enc-land);
    stroke: rgb(165 185 211 / 28%);
    stroke-width: 1;
  }

  .no-estimate__hatch-line {
    stroke: var(--enc-hatch);
    stroke-opacity: var(--enc-hatch-alpha);
  }

  .no-estimate__pin {
    fill: none;
    stroke: var(--color-ion);
    stroke-width: 1.6;
  }

  .no-estimate__crosshair {
    fill: none;
    stroke: var(--color-ion);
    stroke-opacity: 0.7;
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  /* The readout: the docked strip's look (Readout.astro), on the end of the crosshair's arm. */
  .no-estimate__readout {
    display: grid;
    flex: 1 1 9rem;
    max-width: 15rem;
    padding: 0.65rem 0.9rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    background: var(--color-plate);
    color: var(--color-text-soft);
    font-size: var(--type-legend);
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1.45;
  }

  /* The readout never narrows below its first line, so a column too narrow for it beside the
     patch puts it under the patch instead. */
  .no-estimate__kind {
    display: flex;
    white-space: nowrap;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-starlight);
    font-weight: 620;
  }

  .no-estimate__value {
    color: var(--color-starlight);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .no-estimate__note {
    text-wrap: balance;
  }

  /* Forced colours (spec §2.2): the hatch keeps its strokes; lines take the system colours. */
  @media (forced-colors: active) {
    .no-estimate__patch {
      forced-color-adjust: none;
    }

    .no-estimate__land {
      fill: Canvas;
      stroke: CanvasText;
    }

    .no-estimate__hatch-line,
    .no-estimate__pin,
    .no-estimate__crosshair {
      stroke: CanvasText;
      stroke-opacity: 1;
    }
  }
</style>
