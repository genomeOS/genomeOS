---
/**
 * Home (site redesign spec §4.1, #454; round 2 rulings R2-1, R2-2): the hero film under the page's
 * heading and calls to action, then seven concepts, each one figure plus its legend, in this order:
 * the genomeOS Atlas preview (#atlas, the toy globe), counts not guesses (#why), the Pipeline
 * (#how), the evidence base (#metrics-title), potential applications, the larger vision, and one
 * closing band.
 */
import ralewayLatin from '@fontsource-variable/raleway/files/raleway-latin-wght-normal.woff2?url';
import BrandName from '../components/BrandName.astro';
import ApplicationCard from '../components/project/ApplicationCard.astro';
import CountsFigure from '../components/project/CountsFigure.astro';
import EvidenceBase from '../components/home/EvidenceBase.astro';
import AtlasPreview from '../components/home/AtlasPreview.astro';
import HeroMedia from '../components/home/HeroMedia.astro';
import type { HeroVideoSource } from '../components/home/hero-media';
import OpenField from '../components/home/OpenField.astro';
import VisionStrip from '../components/home/VisionStrip.astro';
import Glyph from '../components/kit/Glyph.astro';
import Pipeline from '../components/kit/Pipeline.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/paths';
import '../styles/pages/home.css';
import heroPoster from '../assets/hero/hero-poster.webp';

/*
 * The hero film (round 2, ruling R2-1): the owner's render, played whole at a quarter speed
 * (motion-interpolated to 24 fps) as a seamless loop of about a minute, without audio. To swap the clip, replace these files (and the poster, its first frame, above) and keep
 * each codecs string true to its encode (`ffprobe`; AV1 first, then HEVC, within a width).
 */
const heroFilm: HeroVideoSource[] = [
  {
    src: sitePath('/media/hero/hero-720.av1.mp4'),
    type: 'video/mp4; codecs="av01.0.05M.10"',
    width: 1280,
  },
  {
    src: sitePath('/media/hero/hero-720.hevc.mp4'),
    type: 'video/mp4; codecs="hvc1.1.6.L93.90"',
    width: 1280,
  },
  {
    src: sitePath('/media/hero/hero-1080.av1.mp4'),
    type: 'video/mp4; codecs="av01.0.08M.10"',
    width: 1920,
  },
  {
    src: sitePath('/media/hero/hero-1080.hevc.mp4'),
    type: 'video/mp4; codecs="hvc1.1.6.L120.90"',
    width: 1920,
  },
];

const applications = [
  {
    title: 'Screening programmes',
    horizon: 'First-release direction',
    tone: 'aurora',
    line: 'Where carrier screening would help most.',
  },
  {
    title: 'Diagnostic context',
    horizon: 'Clinical validation needed',
    tone: 'signal',
    line: 'Regional context before a genetic test.',
  },
  {
    title: 'Trial planning',
    horizon: 'Study planning',
    tone: 'ion',
    line: 'Where a study could find enough carriers.',
  },
  {
    title: 'The map of what we don’t know',
    horizon: 'Headline output',
    tone: 'ion',
    line: 'Where the next sample matters most.',
  },
  {
    title: 'Medicines and drug response',
    horizon: 'Future exploration',
    tone: 'genome',
    line: 'Variants that change a dose.',
  },
  {
    title: 'Research and discovery',
    horizon: 'Hypothesis generation',
    tone: 'ion',
    line: 'Patterns worth testing.',
  },
] as const;

const repository = 'https://github.com/genomeOS/genomeOS';
const routes = [
  {
    href: `${repository}/discussions/76`,
    lead: 'Meet the community',
    label: 'Introduce yourself',
    external: true,
    primary: true,
  },
  {
    href: sitePath('/contribute/#working-groups'),
    lead: 'Find your group',
    label: 'Working groups',
    external: false,
    primary: false,
  },
  {
    href: `${repository}/issues`,
    lead: 'See what needs doing',
    label: 'Open issues',
    external: true,
    primary: false,
  },
  {
    href: 'https://github.com/orgs/genomeOS/projects/1',
    lead: 'See the roadmap',
    label: 'Project board',
    external: true,
    primary: false,
  },
];
---

<SiteLayout
  title="genomeOS"
  description="The genomeOS Foundation promotes open science where genomics, AI and public health meet. Anyone can help build open tools, starting with the genomeOS Atlas."
>
  <link
    slot="head"
    rel="preload"
    href={ralewayLatin}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <Glyph sprite />

  <section class="home-hero" id="hero" aria-labelledby="hero-title">
    <HeroMedia
      poster={heroPoster}
      sources={heroFilm}
      position={{ wide: '62% 32%', tall: '61% 40%' }}
    >
      <div class="section-shell home-hero__inner">
        <div class="home-hero__text">
          <h1 id="hero-title">Open science <br />for the benefit of all.</h1>
          <p class="home-hero__lede">
            Data, models and tools built in the open, with anyone, for everyone.
          </p>
          <div class="home-hero__actions">
            <a class="button-link" href={sitePath('/app/')}>Open the Atlas</a>
            <a class="button-link button-link--quiet" href="#how"
              >How it works</a
            >
          </div>
        </div>
      </div>
    </HeroMedia>
  </section>

  <section
    class="band home-atlas"
    id="atlas"
    data-concept
    aria-labelledby="atlas-title"
  >
    <div class="section-shell home-atlas__grid">
      <div class="home-atlas__text home-head">
        <p class="section-kicker">Our flagship project</p>
        <h2 id="atlas-title">The <BrandName /> Atlas</h2>
        <p class="home-atlas__lede">
          An open, interactive map of human genetic variation.
        </p>
      </div>
      <div class="home-atlas__figure">
        <AtlasPreview />
      </div>
    </div>
  </section>

  <section
    class="band band--orbit home-why"
    id="why"
    data-concept
    aria-labelledby="why-title"
  >
    <div class="section-shell layout-figure-split">
      <div class="layout-figure-split__text home-head">
        <p class="section-kicker">Why <BrandName /></p>
        <h2 id="why-title">Genetic knowledge should serve everyone.</h2>
        <div class="mission-copy">
          <p>
            Location matters because a genetic variant can be common in one
            population and rare in another.
          </p>
        </div>
      </div>
      <div class="layout-figure-split__figure">
        <CountsFigure />
      </div>
    </div>
  </section>

  <section
    class="band home-how"
    id="how"
    data-concept
    aria-labelledby="how-title"
  >
    <div class="section-shell layout-wide-figure">
      <div class="layout-wide-figure__head home-head">
        <p class="section-kicker">How <BrandName /> works</p>
        <h2 id="how-title">
          Measured first. Modeled second. Uncertainty always.
        </h2>
      </div>
      <div class="layout-wide-figure__figure">
        <Pipeline mode={3} modeToggle={false} idPrefix="home-how" />
      </div>
    </div>
  </section>

  <section
    class="band band--orbit home-metrics"
    id="metrics"
    data-concept
    aria-labelledby="metrics-title"
  >
    <div class="section-shell layout-figure-split">
      <div class="layout-figure-split__text home-head">
        <h2 id="metrics-title">A growing global evidence base.</h2>
      </div>
      <div class="layout-figure-split__figure">
        <EvidenceBase />
      </div>
    </div>
  </section>

  <section
    class="band home-apps"
    id="applications"
    data-concept
    aria-labelledby="applications-title"
    data-motion-surface
  >
    <div class="section-shell home-apps__layout">
      <div class="home-head home-apps__head">
        <p class="section-kicker">Potential applications</p>
        <h2 id="applications-title">
          From scattered evidence to better decisions.
        </h2>
      </div>
      <a
        class="github-cta home-apps__cta"
        href={`${repository}/discussions/1`}
        target="_blank"
        rel="noopener noreferrer"
        ><span>Help shape it</span><strong>Suggest an application</strong><span
          aria-hidden="true">↗</span
        ></a
      >
      <div class="home-apps__figure">
        <figure class="apps" data-graphic="applications" data-kind="mechanism">
          <figcaption class="apps__rule" data-figure-chrome>
            Population evidence is context, not a diagnosis.
          </figcaption>
          <div
            class="apps__grid"
            data-figure-stage
            role="group"
            aria-labelledby="applications-title"
          >
            {
              applications.map((application, index) => (
                <ApplicationCard
                  index={index}
                  glyph={(index + 1) as 1 | 2 | 3 | 4 | 5 | 6}
                  {...application}
                />
              ))
            }
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section
    class="band band--orbit home-vision"
    id="vision"
    data-concept
    aria-labelledby="vision-title"
  >
    <div class="section-shell layout-figure-split">
      <div class="layout-figure-split__text home-head">
        <h2 id="vision-title">From one world map to many biological scales.</h2>
        <a class="home-vision__link" href={sitePath('/projects/#vision')}
          >Explore the larger vision <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="layout-figure-split__figure">
        <VisionStrip />
      </div>
    </div>
  </section>

  <section
    class="band home-open"
    id="open"
    data-concept
    aria-labelledby="open-title"
  >
    <div class="section-shell home-open__grid">
      <div class="home-open__text home-head">
        <p class="section-kicker">Built in the open</p>
        <h2 id="open-title">
          A global community can build what no single lab can.
        </h2>
        <p class="home-open__line">Open source, for the public good.</p>
      </div>
      <div class="home-open__figure">
        <OpenField />
      </div>
      <div class="link-row link-row--four home-open__routes">
        {
          routes.map((route) => (
            <a
              class:list={[
                'github-cta',
                { 'github-cta--primary': route.primary },
              ]}
              href={route.href}
              data-open-cta
              target={route.external ? '_blank' : undefined}
              rel={route.external ? 'noopener noreferrer' : undefined}
            >
              <span>{route.lead}</span>
              <strong>{route.label}</strong>
              <span aria-hidden="true">{route.external ? '↗' : '→'}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  /*
   * The page's one island (site redesign spec §7; #454): every Home figure starts here, so the
   * page fetches one module instead of one per figure, as Project and Contribute do.
   */
  import { initAtlasPreview } from '../components/home/atlas-preview';
  import { initCounts } from '../components/project/counts';
  import { initHeroMedia } from '../components/home/hero-media';
  import { FigureController } from '../graphics/figure';

  const each = (selector: string, init: (figure: HTMLElement) => void) => {
    for (const figure of document.querySelectorAll<HTMLElement>(selector))
      init(figure);
  };

  for (const hero of document.querySelectorAll<HTMLElement>(
    '[data-hero-media]',
  ))
    initHeroMedia(hero);
  each('figure[data-graphic="atlas-preview"]', initAtlasPreview);
  each('figure[data-graphic="counts"]', initCounts);
  // The evidence base's totals are static text; its composition bars grow once (CSS, home.css).
  each(
    'figure[data-graphic="evidence-base"]',
    (figure) => new FigureController(figure, { duration: 600, rest() {} }),
  );
  // The application glyphs draw in once, 90 ms apart (CSS, applications.css); each replays its mechanism
  // on hover.
  each(
    'figure[data-graphic="applications"]',
    (figure) => new FigureController(figure, { duration: 1100, rest() {} }),
  );
  // The vision strip's entrance is CSS only: the frames fade in left to right, once (home.css).
  each(
    'figure[data-graphic="vision"]',
    (figure) => new FigureController(figure, { duration: 700, rest() {} }),
  );
</script>
