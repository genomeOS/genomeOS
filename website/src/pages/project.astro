---
/**
 * The project (site redesign spec §4.2, #454): how scattered evidence is joined, the HbS proof
 * case, the multi-scale vision, the six safeguards, the pipeline and what exists today. Six concept
 * sections, each carried by one figure; the words are the spec's copy deck.
 *
 *   intro + join-up  →  #hbs  →  #vision  →  #safeguards-title  →  #pipeline-title  →  status
 *   →  follow the work (a link row, no figure)
 */
import BrandName from '../components/BrandName.astro';
import Glyph from '../components/kit/Glyph.astro';
import Icon from '../components/kit/Icon.astro';
import type { IconName } from '../components/kit/icons';
import Pipeline from '../components/kit/Pipeline.astro';
import PageIntro from '../components/PageIntro.astro';
import HbsThresholdMap from '../components/project/HbsThresholdMap.astro';
import JoinUp from '../components/project/JoinUp.astro';
import SafeguardTile from '../components/project/SafeguardTile.astro';
import ScaleLadder from '../components/project/ScaleLadder.astro';
import StatusRail from '../components/project/StatusRail.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/paths';
import '../styles/pages/project.css';

const SAFEGUARDS = [
  {
    title: 'Measurements and estimates never merge',
    line: 'Separate tables, layers and legends.',
  },
  {
    title: 'Unknown stays visible',
    line: 'Too little evidence is hatched, never coloured.',
  },
  {
    title: 'Zoom cannot manufacture detail',
    line: 'A coarse cell stays one cell.',
  },
  {
    title: 'Sampling corrections stay inspectable',
    line: 'Every adjustment can be switched off.',
  },
  {
    title: 'Clinical scope is enforced',
    line: 'Single-variant conditions and drug response only.',
  },
  {
    title: 'No evidence means no number',
    line: 'A blank beats a plausible guess.',
  },
] as const;

const REPOSITORY = 'https://github.com/genomeOS/genomeOS/blob/main';
const LINKS: {
  label: string;
  href: string;
  icon: IconName;
  external: boolean;
}[] = [
  {
    label: 'Project board',
    href: 'https://github.com/orgs/genomeOS/projects/1',
    icon: 'board',
    external: true,
  },
  {
    label: 'Overview',
    href: `${REPOSITORY}/docs/overview.md`,
    icon: 'document',
    external: true,
  },
  {
    label: 'Objectives',
    href: `${REPOSITORY}/docs/scientific-engineering-objectives.md`,
    icon: 'document',
    external: true,
  },
  {
    label: 'Atlas v1 design',
    href: `${REPOSITORY}/docs/superpowers/specs/2026-08-22-genome-os-atlas-v1-design.md`,
    icon: 'document',
    external: true,
  },
  { label: 'Docs', href: sitePath('/docs/'), icon: 'arrow', external: false },
];
---

<SiteLayout
  title="The project"
  description="How genomeOS joins scattered genetic evidence, why haemoglobin S is its first test, the multi-scale vision, the safeguards, the pipeline, and what exists today."
>
  <Glyph sprite />
  <Icon sprite />

  <div class="proj-intro" id="join-up" data-concept>
    <PageIntro
      layout="split"
      note="The project"
      title="A world atlas built from evidence, not assumptions."
      lede="The data exists. It just doesn’t work together yet. genomeOS places it, models what it supports, and shows the gaps."
    >
      <JoinUp slot="figure" />
    </PageIntro>
  </div>

  <section
    class="band band--orbit proj-hbs"
    id="hbs"
    data-concept
    aria-labelledby="hbs-title"
  >
    <div class="section-shell">
      <div class="proj-head proj-head--split">
        <h2 id="hbs-title">Why haemoglobin S makes the mission tangible</h2>
        <p class="proj-lede">
          One copy can protect against severe malaria; two cause sickle-cell
          disease. Its frequency traces biology, environment and history.
        </p>
      </div>
      <HbsThresholdMap />
      <p class="proj-gate">
        <strong>A plausible map is not success.</strong> Until <BrandName /> reproduces
        published HbS, G6PD and carrier-screening results, every surface says “not
        yet validated”.
      </p>
    </div>
  </section>

  <section
    class="band proj-vision"
    id="vision"
    data-concept
    aria-labelledby="vision-title"
  >
    <div class="section-shell">
      <h2 class="proj-h2" id="vision-title">
        One connected view, from cells to Earth.
      </h2>
      <ScaleLadder />
    </div>
  </section>

  <section
    class="band band--orbit proj-safeguards"
    id="safeguards"
    data-concept
    aria-labelledby="safeguards-title"
  >
    <div class="section-shell">
      <figure class="sg" data-graphic="safeguards" data-safeguards>
        <figcaption>
          <h2 class="proj-h2" id="safeguards-title">
            Six rules the interface cannot hide
          </h2>
        </figcaption>
        <svg class="sg-defs" aria-hidden="true" focusable="false">
          <defs>
            <pattern
              id="sg-hatch"
              width="5"
              height="5"
              patternUnits="userSpaceOnUse"
              patternTransform="rotate(45)"
            >
              <rect class="sg-hatch-ground" width="5" height="5"></rect>
              <path class="sg-hatch-stroke" d="M2.5 0V5"></path>
            </pattern>
          </defs>
        </svg>
        <div
          class="sg-stage"
          data-figure-stage
          role="group"
          aria-labelledby="safeguards-title"
        >
          <ol class="sg-grid">
            {
              SAFEGUARDS.map((rule, index) => (
                <SafeguardTile
                  rule={(index + 1) as 1 | 2 | 3 | 4 | 5 | 6}
                  title={rule.title}
                  line={rule.line}
                />
              ))
            }
          </ol>
        </div>
      </figure>
      <a class="proj-more" href={sitePath('/docs/scientific-safeguards/')}
        >Read the safeguards in Docs<Icon name="arrow" size={18} /></a
      >
    </div>
  </section>

  <section
    class="band proj-pipeline"
    id="pipeline"
    data-concept
    aria-labelledby="pipeline-title"
  >
    <div class="section-shell">
      <h2 class="proj-h2 proj-pipeline__title" id="pipeline-title">
        From evidence to an explorable map
      </h2>
      <Pipeline mode={6} stageBrackets={false} idPrefix="project-pipeline" />
    </div>
  </section>

  <section
    class="band band--orbit proj-status"
    id="status"
    data-concept
    aria-labelledby="status-title"
  >
    <div class="section-shell">
      <StatusRail titleId="status-title" />
    </div>
  </section>

  <section class="band proj-follow" aria-labelledby="follow-title">
    <div class="section-shell">
      <h2 class="proj-h2" id="follow-title">Follow the work</h2>
      <ul class="proj-links">
        {
          LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                <Icon name={link.icon} />
                <span>{link.label}</span>
                {link.external && (
                  <Icon name="external" size={18} class="proj-links__out" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</SiteLayout>

<script>
  /*
   * The page's one island (site redesign spec §2.7, §4.2; #454): every Project figure starts here,
   * so the page ships one module instead of one per figure. The HbS map's data load only once
   * that figure is near view.
   */
  import { initGenotype } from '../components/project/genotype';
  import { initHbsMap } from '../components/project/hbs-map';
  import { initJoinUp } from '../components/project/join-up';
  import { initLadder } from '../components/project/ladder';
  import { FigureController, prefersReducedMotion } from '../graphics/figure';

  const once = (selector: string, init: (element: HTMLElement) => void) => {
    for (const element of document.querySelectorAll<HTMLElement>(selector)) {
      if (element.hasAttribute('data-island')) continue;
      element.toggleAttribute('data-island', true);
      init(element);
    }
  };

  /** Play a CSS-keyed entrance once (project.css: is-armed, then is-playing). */
  const cssEntrance = (figure: HTMLElement, duration: number) =>
    new FigureController(figure, {
      duration,
      arm: () => figure.classList.add('is-armed'),
      start: () => {
        figure.classList.remove('is-armed');
        figure.classList.add('is-playing');
      },
      rest: () => figure.classList.remove('is-armed', 'is-playing'),
    });

  once('[data-joinup]', initJoinUp);
  once('[data-genotype-root]', initGenotype);
  once('[data-ladder]', initLadder);

  // The HbS map (hbs-map.ts) and its two data files, once it is within 600 px of view.
  const urls = import.meta.glob(
    ['../data/figures/hbs-region.*.bin', '../data/figures/hbs-surveys.*.bin'],
    { query: '?url', import: 'default', eager: true },
  ) as Record<string, string>;
  const pick = (prefix: string) =>
    Object.entries(urls).find(([file]) => file.includes(`/${prefix}.`))?.[1];
  once('figure[data-graphic="hbs-threshold"]', (figure) => {
    const region = pick('hbs-region');
    const surveys = pick('hbs-surveys');
    if (!region || !surveys) return;
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        near.disconnect();
        void initHbsMap(figure, { region, surveys });
      },
      { rootMargin: '600px 0px' },
    );
    near.observe(figure);
  });

  // The six safeguards (spec §4.2, safeguards): CSS plays them once, 120 ms apart; hovering one replays it.
  const TILE_MS = 1600;
  once('[data-safeguards]', (figure) => {
    const tiles = [...figure.querySelectorAll<HTMLElement>('.sg-tile')];
    cssEntrance(figure, TILE_MS + (tiles.length - 1) * 120);
    for (const tile of tiles) {
      let timer = 0;
      tile.addEventListener('pointerenter', () => {
        if (prefersReducedMotion() || figure.dataset.figureState !== 'rest')
          return;
        tile.classList.remove('is-replaying');
        void tile.offsetWidth;
        tile.classList.add('is-replaying');
        window.clearTimeout(timer);
        timer = window.setTimeout(
          () => tile.classList.remove('is-replaying'),
          TILE_MS,
        );
      });
    }
  });

  // The status rail (spec §4.2, status): it draws once; an item and its node light each other.
  once('[data-rail]', (figure) => {
    for (const item of figure.querySelectorAll<HTMLElement>('[data-item]')) {
      const node = figure.querySelector<HTMLElement>(
        `[data-node="${item.dataset.item}"]`,
      );
      const light = (on: boolean) => {
        item.classList.toggle('is-lit', on);
        node?.classList.toggle('is-lit', on);
      };
      for (const target of [item, node])
        if (target) {
          target.addEventListener('pointerenter', () => light(true));
          target.addEventListener('pointerleave', () => light(false));
        }
    }
    cssEntrance(figure, 1100);
  });
</script>
