---
/**
 * /project/ is now Projects at /projects/ (round 2 spec §1.3, R2-4; #454). GitHub Pages is static,
 * so this is a real page, built like /working-groups/: it renders through SiteLayout (one analytics
 * bootstrap, one cookie control, the viewport meta, one h1), stays out of search results and the
 * sitemap, and sends visitors on before first paint. Every old fragment exists unchanged on
 * Projects except the retired vision section's, which land on Status. Without JavaScript the meta
 * refresh lands on /projects/ (no fragment).
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/paths';

const base = sitePath('/projects/');
const fragments: Record<string, string> = {
  '#vision': '#status',
  '#vision-title': '#status-title',
};
const redirect = `location.replace(${JSON.stringify(base)}+(${JSON.stringify(fragments)}[location.hash]??location.hash));`;
---

<SiteLayout
  title="Projects"
  description="The project page is now Projects."
  noindex
  canonicalPath="/projects/"
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${base}`} />
    <script is:inline data-redirect set:html={redirect} />
  </Fragment>
  <section class="page-intro page-intro--redirect">
    <div class="section-shell page-intro__inner">
      <h1>The project page is now Projects.</h1>
      <p><a href={base}>Go to Projects</a></p>
    </div>
  </section>
</SiteLayout>
