<script>
  import { hopKeys, poseTracks, type PoseKey } from '../graphics/astro/tracks';
  import { sceneController } from '../graphics/timeline';

  /*
   * The test scene (tests/kit.spec.ts): A3 hops 160 units to the right in the 2 s story, then hops
   * in place in every 2 s loop. Pose keys carry x by the hop's travel.
   */
  const withTravel = (keys: PoseKey[], travel: [number, number][]): PoseKey[] =>
    keys.map(([t, key, easing]) => {
      const spec = typeof key === 'string' ? { pose: key } : key;
      let x = travel[0][1];
      for (let i = 1; i < travel.length; i++) {
        const [t0, x0] = travel[i - 1];
        const [t1, x1] = travel[i];
        if (t >= t1) x = x1;
        else if (t > t0) x = x0 + ((x1 - x0) * (t - t0)) / (t1 - t0);
      }
      return [t, { ...spec, x }, easing];
    });
  const sceneFigure = document.querySelector<HTMLElement>(
    '[data-graphic="kit-scene"]',
  );
  const hopper = sceneFigure?.querySelector('#kit-hopper .astro');
  if (sceneFigure && hopper)
    sceneController(
      sceneFigure,
      (tl) => {
        const across = hopKeys(0, 0, 160, { dur: 900 });
        poseTracks(tl, 'story', hopper, 'A3', [
          ...withTravel(across.keys, across.travel),
          [2000, { pose: 'stand', x: 160 }],
        ]);
        const inPlace = hopKeys(300, 160, 160, { dur: 700, height: -18 });
        poseTracks(tl, 'loop', hopper, 'A3', [
          [0, { pose: 'stand', x: 160 }],
          ...withTravel(inPlace.keys, inPlace.travel),
          [2000, { pose: 'stand', x: 160 }],
        ]);
      },
      {
        name: 'kit-scene',
        timeline: { story: 2000, loop: 2000 },
        controls: {
          toggle: sceneFigure.querySelector<HTMLButtonElement>(
            '[data-scene-toggle]',
          ),
          replay: sceneFigure.querySelector<HTMLButtonElement>(
            '[data-scene-replay]',
          ),
        },
      },
    );
</script>

<script>
  import { decodeAreas, decodeSurveys } from '../graphics/figure-data';
  import { FigureController, createAnnouncer } from '../graphics/figure';
  import { HexField, type HexHit, type HexLayer } from '../graphics/hexfield';
  import { haversineKm, orthographic } from '../graphics/projection';
  import { tween, easeUi } from '../graphics/tween';
  import provenance from '../data/figures/hbs.provenance.json';

  const urls = import.meta.glob('../data/figures/hbs-*.bin', {
    query: '?url',
    import: 'default',
    eager: true,
  }) as Record<string, string>;
  const url = (prefix: string) =>
    Object.entries(urls).find(([path]) => path.includes(`/${prefix}.`))![1];

  async function hexfieldDemo(
    figure: HTMLElement,
    canvas: HTMLCanvasElement,
    readout: HTMLElement,
  ) {
    const [globe, surveys] = await Promise.all([
      fetch(url('hbs-globe')).then((response) => response.arrayBuffer()),
      fetch(url('hbs-surveys')).then((response) => response.arrayBuffer()),
    ]);
    // A window that holds every evidence tier and some areas with no estimate.
    const centre: [number, number] = [45, 35];
    const areas = decodeAreas(globe)
      .map((area) => ({ area, km: haversineKm(centre, area.center) }))
      .sort((a, b) => a.km - b.km)
      .slice(0, 300)
      .map(({ area }) => area);
    const reach = Math.max(
      ...areas.map((area) => haversineKm(centre, area.center)),
    );
    const field = new HexField(canvas, {
      areas,
      surveys: decodeSurveys(surveys).filter(
        (survey) => haversineKm(centre, [survey.lon, survey.lat]) <= reach,
      ),
      projection: orthographic({ center: centre, scale: 1, translate: [0, 0] }),
      domain: provenance.metric_domain.post_mean as [number, number],
      fit(width, height, projection) {
        // The whole window on the disc: its farthest area centre plus about one res-2 cell.
        const angle = (reach + 200) / 6371;
        projection.scale =
          (Math.min(width, height) / 2 / Math.sin(angle)) * 0.96;
        projection.translate = [width / 2, height / 2];
      },
    });
    new ResizeObserver(() => field.resize()).observe(canvas);

    const announce = createAnnouncer(readout);
    const pct = (value: number) => `${(value * 100).toFixed(1)}%`;
    const describe = (hit: HexHit | null) => {
      if (!hit) return 'Point at an area or a survey.';
      if (hit.type === 'surveys') {
        const [first] = hit.surveys;
        return hit.surveys.length > 1
          ? `${hit.surveys.length} surveys here · ${hit.surveys
              .slice(0, 2)
              .map((survey) => `${survey.ac} of ${survey.an}`)
              .join(' · ')}`
          : `Measured survey · ${first.ac} of ${first.an} alleles carry HbS · within ±${first.radiusKm} km`;
      }
      const { area } = hit;
      if (area.mean === null) return 'No estimate · — · no survey in range';
      return `Modeled estimate about ${pct(area.mean)} · 95% range ${pct(area.lo!)}–${pct(area.hi!)} · nearest survey about ${area.distanceKm} km`;
    };
    canvas.addEventListener('pointermove', (event) => {
      const box = canvas.getBoundingClientRect();
      field.hover = field.hit(
        event.clientX - box.left,
        event.clientY - box.top,
      );
      field.draw();
      announce(describe(field.hover));
    });

    const controller = new FigureController(figure, {
      duration: 2800,
      arm() {
        field.reveal = { land: 0, studs: 0, surface: 0, hatch: 0 };
        field.draw();
      },
      render(t) {
        const clamp = (value: number) => Math.min(1, Math.max(0, value));
        field.reveal = {
          land: clamp(t / 300),
          studs: clamp((t - 300) / 700),
          surface: clamp((t - 1000) / 1400),
          hatch: clamp((t - 2400) / 400),
        };
        field.draw();
      },
      rest() {
        field.reveal = { land: 1, studs: 1, surface: 1, hatch: 1 };
        field.draw();
      },
    });
    figure.addEventListener('segmented:change', (event) => {
      const layer = (event as CustomEvent<{ value: HexLayer }>).detail.value;
      if (controller.reduced) {
        field.setLayer(layer);
        return;
      }
      field.setLayer(layer, 0);
      tween(240, (amount) => field.setLayer(layer, amount), easeUi);
    });
  }

  const figure = document.querySelector<HTMLElement>('.devkit-hexfield');
  const canvas = figure?.querySelector<HTMLCanvasElement>(
    '[data-devkit-canvas]',
  );
  const readout = figure?.querySelector<HTMLElement>('[data-readout]');
  if (figure && canvas && readout) void hexfieldDemo(figure, canvas, readout);
</script>

