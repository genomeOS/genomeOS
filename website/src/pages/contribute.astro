---
/**
 * Contribute (site redesign spec §4.3, #454), which absorbs the Working groups page:
 *
 *   intro             H1 left, lede right (PageIntro split)
 *   #working-groups   the transit line (the page's lead figure) and the three group cards
 *   #how-work-moves   the work board: one issue, five steps; milestones; the Docs workflow
 *   #start            four places to start (a link row, no figure)
 *
 * /working-groups/ redirects here (#working-groups, and #data, #modeling, #ui to the cards).
 */
import GroupCard from '../components/contribute/GroupCard.astro';
import MilestoneRail from '../components/contribute/MilestoneRail.astro';
import TransitLine from '../components/contribute/TransitLine.astro';
import WorkBoard from '../components/contribute/WorkBoard.astro';
import Mark from '../components/contribute/Mark.astro';
import PageIntro from '../components/PageIntro.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/paths';
import '../styles/pages/contribute.css';

const ISSUES =
  'https://github.com/genomeOS/genomeOS/issues?q=is%3Aissue+is%3Aopen+label%3A%22skill%3A';

const groups = [
  {
    id: 'group-data',
    lane: 'data',
    title: 'Data Gathering & Infrastructure',
    scope:
      'Find allele counts in papers, supplements and non-English literature. Place every population with a stated uncertainty, then store and serve every version.',
    chips: [
      'Literature review',
      'Population genetics',
      'Data engineering',
      'Multilingual sources',
    ],
    issues: `${ISSUES}data-engineering%22`,
  },
  {
    id: 'group-modeling',
    lane: 'modeling',
    title: 'Statistical & AI Modeling',
    scope:
      'The world has not been sampled evenly. Brian leads Bayesian spatial models; geometric deep learning welcome. Frequencies become disease-burden and risk estimates.',
    chips: [
      'Spatial statistics',
      'Bayesian methods',
      'Epidemiology',
      'Model validation',
    ],
    issues: `${ISSUES}spatial-stats%22`,
  },
  {
    id: 'group-ui',
    lane: 'ui',
    title: 'UI & Applications',
    scope:
      'Make estimates and unknowns legible to anyone. Future exploration: an agentic AI guide and people’s own genomes, gated by privacy, consent and governance.',
    future: {
      before: 'Make estimates and unknowns legible to anyone.',
      lead: 'Future exploration:',
      after:
        'an agentic AI guide and people’s own genomes, gated by privacy, consent and governance.',
    },
    chips: [
      'Interface design',
      'Geospatial',
      'Accessible visualisation',
      'Governance',
    ],
    issues: `${ISSUES}frontend%22`,
  },
] as const;

const starts = [
  {
    href: 'https://github.com/genomeOS/genomeOS/discussions/76',
    kicker: 'Meet the community',
    title: 'Introduce yourself',
    primary: true,
  },
  {
    href: 'https://github.com/genomeOS/genomeOS/issues/new/choose',
    kicker: 'Bring a direction',
    title: 'Propose an issue',
  },
  {
    href: 'https://github.com/orgs/genomeOS/projects/1',
    kicker: 'See what is Ready',
    title: 'Project board',
  },
  {
    href: 'https://github.com/genomeOS/genomeOS/issues/65',
    kicker: 'How we work',
    title: 'Community standards',
  },
];
---

<SiteLayout
  title="Contribute"
  description="Join a genomeOS working group, take Ready work from the project board, and open a reviewable contribution."
>
  <PageIntro
    layout="split"
    note="Open collaboration"
    title="Find work that fits how you think."
    lede="Literature, statistics, engineering, design, clinical and community knowledge all move the atlas. Every contribution starts with a conversation."
  />

  <section
    class="band contribute-band wg-section"
    id="working-groups"
    data-concept
    aria-labelledby="working-groups-title"
  >
    <div class="section-shell">
      <h2 class="contribute-h2" id="working-groups-title">
        Three groups are forming.
      </h2>
      <TransitLine />
      <div class="wg-cards" data-graphic="group-vignettes">
        {groups.map((group) => <GroupCard {...group} />)}
      </div>
    </div>
  </section>

  <section
    class="band band--orbit contribute-band wb-section"
    id="how-work-moves"
    data-concept
    aria-labelledby="how-work-moves-title"
  >
    <div class="section-shell">
      <div class="contribute-head">
        <h2 class="contribute-h2" id="how-work-moves-title">How work moves</h2>
        <p class="contribute-legend">
          <strong>One issue, from hello to review.</strong> Board statuses mean exactly
          what they say.
        </p>
      </div>
      <WorkBoard />
      <MilestoneRail />
      <p class="contribute-more">
        <a href={sitePath('/docs/issues-and-projects/')}
          >The full workflow in Docs <Mark icon="arrow" size={18} /></a
        >
      </p>
    </div>
  </section>

  <section
    class="band contribute-band start-section"
    id="start"
    aria-labelledby="start-title"
  >
    <div class="section-shell">
      <h2 class="contribute-h2" id="start-title">Start here.</h2>
      <div class="link-row start-links">
        {
          starts.map((start) => (
            <a
              class:list={[
                'github-cta',
                start.primary && 'github-cta--primary',
              ]}
              href={start.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{start.kicker}</span>
              <strong>{start.title}</strong>
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // The page's one island: both figures' behaviour in a single module, so a visitor fetches one
  // script for them (site redesign spec §7: ≤ 10 KB of first-party JS on Contribute).
  import '../components/contribute/transit';
  import '../components/contribute/board';
</script>
