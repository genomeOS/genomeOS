---
/**
 * Contribute (site redesign spec §4.3; round 2 spec §4.3, R2-5; #454), which absorbs the Working
 * groups page:
 *
 *   intro             H1 left, lede right (PageIntro split)
 *   #working-groups   the orbit scene: three working-group moons, crews landing, and each group's
 *                     text typed below it (the page's lead figure; OrbitScene.astro)
 *   #flow             how the groups fit together: the transit line
 *   #how-work-moves   the work board (HowWorkMoves.astro, its own section, CSS and script)
 *   #start            four places to start, and offers by email (a link row, no figure)
 *
 * /working-groups/ redirects here (#working-groups, and #data, #modeling, #ui to the orbit's
 * columns, #group-data, #group-modeling, #group-ui).
 */
import HowWorkMoves from '../components/contribute/HowWorkMoves.astro';
import Mark from '../components/contribute/Mark.astro';
import OrbitScene from '../components/contribute/OrbitScene.astro';
import TransitLine from '../components/contribute/TransitLine.astro';
import PageIntro from '../components/PageIntro.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/paths';
import '../styles/pages/contribute.css';

// Data, expertise and funding are offered by email: each link opens the Contact page's draft
// with that offer pressed (Contact page spec §4, "Links in").
const offers = ['data', 'expertise', 'funding'] as const;

const starts = [
  {
    href: 'https://github.com/genomeOS/genomeOS/discussions/76',
    kicker: 'Meet the community',
    title: 'Introduce yourself',
    primary: true,
  },
  {
    href: 'https://github.com/genomeOS/genomeOS/issues/new/choose',
    kicker: 'Bring a direction',
    title: 'Propose an issue',
  },
  {
    href: 'https://github.com/orgs/genomeOS/projects/1',
    kicker: 'See what is Ready',
    title: 'Project board',
  },
  {
    href: 'https://github.com/genomeOS/genomeOS/issues/65',
    kicker: 'How we work',
    title: 'Community standards',
  },
];
---

<SiteLayout
  title="Contribute"
  description="Join a genomeOS working group, take Ready work from the project board, and open a reviewable contribution."
>
  {
    /*
     * Spec §2.7 rule 5 (round 2 §4.3.2), above the fold never flashes: before any of the page
     * paints, mark the orbit armed, so it paints its story's first moment (contribute.css: an
     * empty stage, every column waiting), never its last frame emptying for the story. Only with
     * motion allowed and the page arriving within 1,200 ms; if the scene has neither begun loading
     * (data-orbit-loading, set by the page's script and kept until the scene has a state) nor been
     * built (data-scene-state) by then, stand down to the last frame.
     */
  }
  <script is:inline slot="head">
    (function (root) {
      try {
        if (
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          performance.now() > 1200
        )
          return;
        root.setAttribute('data-arm-orbit', '');
        setTimeout(
          function () {
            var figure = document.querySelector('[data-graphic="orbit"]');
            if (
              !figure ||
              !(
                figure.hasAttribute('data-scene-state') ||
                figure.hasAttribute('data-orbit-loading')
              )
            )
              root.removeAttribute('data-arm-orbit');
          },
          Math.max(0, 1200 - performance.now()),
        );
      } catch (error) {
        root.removeAttribute('data-arm-orbit');
      }
    })(document.documentElement);
  </script>
  <PageIntro
    layout="split"
    note="Open collaboration"
    title="Find work that fits how you think."
    lede="Literature, statistics, engineering, design, clinical and community knowledge all move the atlas. Every contribution starts with a conversation."
  />

  <section
    class="band contribute-band wg-section"
    id="working-groups"
    data-concept
    aria-labelledby="working-groups-title"
  >
    <div class="section-shell">
      <p class="section-kicker">Working groups</p>
      <h2 class="contribute-h2" id="working-groups-title">
        Three groups are forming.
      </h2>
      <OrbitScene labelledby="working-groups-title" />
    </div>
  </section>

  <section
    class="band contribute-band flow-section"
    id="flow"
    data-concept
    aria-labelledby="flow-title"
  >
    <div class="section-shell">
      <h2 class="contribute-h2" id="flow-title">
        How the groups fit together.
      </h2>
      <TransitLine />
    </div>
  </section>

  <HowWorkMoves />

  <section
    class="band contribute-band start-section"
    id="start"
    aria-labelledby="start-title"
  >
    <div class="section-shell">
      <h2 class="contribute-h2" id="start-title">Start here.</h2>
      <div class="link-row link-row--four start-links">
        {
          starts.map((start) => (
            <a
              class:list={[
                'github-cta',
                start.primary && 'github-cta--primary',
              ]}
              href={start.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{start.kicker}</span>
              <strong>{start.title}</strong>
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
      <p class="start-offers">
        <span class="start-offers__lead">By email</span>
        {
          offers.map((offer) => (
            <a href={sitePath(`/contact/?topic=contribute&offer=${offer}`)}>
              Offer {offer} <Mark icon="arrow" size={18} />
            </a>
          ))
        }
      </p>
    </div>
  </section>
</SiteLayout>

<script>
  /*
   * The page's island (spec §7: Contribute ≤ 10 KB of first-party JS at first load): the transit
   * line's entrance and lane lighting, and a few lines that import the orbit scene (orbit.ts,
   * its own lazily loaded chunk, round 2 spec §7) once the figure is within a viewport of the
   * screen. Under reduced motion the orbit is never imported: its server-rendered last frame is
   * the picture, and nothing would move. The work board's script lives with its section
   * (HowWorkMoves.astro).
   */
  import '../components/contribute/transit';

  const orbit = document.querySelector<HTMLElement>('[data-graphic="orbit"]');
  if (orbit && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const load = () => {
      orbit.setAttribute('data-orbit-loading', '');
      import('../components/contribute/orbit')
        .then(({ initOrbit }) => initOrbit(orbit))
        .catch(() => {
          // Without the scene the last frame stands: never leave the stage armed and empty.
          document.documentElement.removeAttribute('data-arm-orbit');
          orbit.removeAttribute('data-orbit-loading');
        });
    };
    const near = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        near.disconnect();
        load();
      },
      { rootMargin: '100% 0px' },
    );
    near.observe(orbit);
  }
</script>
