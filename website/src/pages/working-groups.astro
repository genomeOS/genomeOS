---
/**
 * /working-groups/ now lives on Contribute (site redesign spec §1.4, §4.7; #454). GitHub Pages is
 * static, so this is a real page: it renders through SiteLayout (one analytics bootstrap, one
 * cookie control, the viewport meta, one h1), stays out of search results and the sitemap, and
 * sends visitors on before first paint. The old section fragments map to the new group cards.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/paths';

const base = sitePath('/contribute/');
const target = `${base}#working-groups`;
const fragments: Record<string, string> = {
  '#data': '#group-data',
  '#modeling': '#group-modeling',
  '#ui': '#group-ui',
};
const redirect = `location.replace(${JSON.stringify(base)}+(${JSON.stringify(fragments)}[location.hash]||'#working-groups'));`;
---

<SiteLayout
  title="Working groups"
  description="Working groups are now part of Contribute."
  noindex
  canonicalPath="/contribute/"
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline data-redirect set:html={redirect} />
  </Fragment>
  <section class="page-intro page-intro--redirect">
    <div class="section-shell page-intro__inner">
      <h1>Working groups are now part of Contribute.</h1>
      <p><a href={target}>Go to the working groups</a></p>
    </div>
  </section>
</SiteLayout>
