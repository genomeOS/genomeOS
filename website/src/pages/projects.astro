---
/**
 * Projects, at /projects/ (round 2 spec §4.2; rulings R2-3, R2-4, R2-14, R2-15, R2-16; #454; the
 * old /project/ redirects here): the Foundation's projects, then the genomeOS Atlas's own chapter,
 * which holds the technical story Home leaves out. Eight concept sections, each carried by one
 * figure; the words are the spec's copy deck.
 *
 *   #projects   intro + the project index (lead figure)
 *   #atlas      chapter opener: Project 1 · genomeOS Atlas · Purpose · Process · Status
 *   Purpose     #hbs (why hemoglobin S) → #applications
 *   Process     #join-up (placing evidence) → #counts (counts, not guesses, in people) →
 *               #pipeline → #safeguards
 *   Status      #status (the evidence totals and the roadmap)
 *   then follow the work (a link row, no figure)
 *
 * Outline: h1 "What we’re building" → h2 "genomeOS Atlas" → an h3 per section (and h2 "Follow
 * the work"). Round 1's ids are kept, so old deep links land after the redirect.
 */
import Glyph from '../components/kit/Glyph.astro';
import Icon from '../components/kit/Icon.astro';
import type { IconName } from '../components/kit/icons';
import Pipeline from '../components/kit/Pipeline.astro';
import PageIntro from '../components/PageIntro.astro';
import ApplicationCard from '../components/project/ApplicationCard.astro';
import ChapterOpener from '../components/project/ChapterOpener.astro';
import CountsFigure from '../components/project/CountsFigure.astro';
import HbsThresholdMap from '../components/project/HbsThresholdMap.astro';
import JoinUp from '../components/project/JoinUp.astro';
import ProjectIndex from '../components/project/ProjectIndex.astro';
import SafeguardTile from '../components/project/SafeguardTile.astro';
import StatusRail from '../components/project/StatusRail.astro';
import { GITHUB_REPOSITORY } from '../data/nav';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/paths';
import '../styles/pages/projects.css';

const APPLICATIONS: {
  title: string;
  horizon?: string;
  tone?: 'aurora' | 'signal' | 'ion' | 'genome';
  line: string;
}[] = [
  {
    title: 'Screening programs',
    horizon: 'First release',
    tone: 'aurora',
    line: 'Where carrier screening would help most.',
  },
  {
    title: 'Diagnostic context',
    horizon: 'Clinical validation needed',
    tone: 'signal',
    line: 'Regional context before a genetic test.',
  },
  {
    title: 'Trial planning',
    line: 'Where a study could find enough carriers.',
  },
  {
    title: 'The map of what we don’t know',
    line: 'Where the next sample matters most.',
  },
  {
    title: 'Medicines and drug response',
    horizon: 'Future exploration',
    tone: 'genome',
    line: 'Variants that change a dose.',
  },
  {
    title: 'Research and discovery',
    line: 'Patterns worth testing.',
  },
];

const SAFEGUARDS = [
  {
    title: 'Measurements and estimates never merge',
    line: 'Separate tables, layers and legends.',
  },
  {
    title: 'Unknown stays visible',
    line: 'Too little evidence is hatched, never colored.',
  },
  {
    title: 'Zoom cannot manufacture detail',
    line: 'A coarse cell stays one cell.',
  },
  {
    title: 'Assumptions remain explicit',
    line: 'No convenient defaults for places, recruitment or denominators.',
  },
  {
    title: 'Clinical scope is enforced',
    line: 'Single-variant conditions and drug response only.',
  },
  {
    title: 'No evidence means no number',
    line: 'A blank beats a plausible guess.',
  },
] as const;

const REPOSITORY = `${GITHUB_REPOSITORY}/blob/main`;
const LINKS: {
  label: string;
  href: string;
  icon: IconName;
  external: boolean;
}[] = [
  {
    label: 'Project board',
    href: 'https://github.com/orgs/genomeOS/projects/1',
    icon: 'board',
    external: true,
  },
  {
    label: 'Overview',
    href: `${REPOSITORY}/docs/overview.md`,
    icon: 'document',
    external: true,
  },
  {
    label: 'Objectives',
    href: `${REPOSITORY}/docs/scientific-engineering-objectives.md`,
    icon: 'document',
    external: true,
  },
  {
    label: 'Atlas v1 design',
    href: `${REPOSITORY}/docs/superpowers/specs/2026-08-22-genome-os-atlas-v1-design.md`,
    icon: 'document',
    external: true,
  },
  { label: 'Docs', href: sitePath('/docs/'), icon: 'arrow', external: false },
];
---

<SiteLayout
  title="Projects"
  description="The genomeOS Foundation's projects. First, the genomeOS Atlas: why it exists, how it works and what comes next."
>
  <Glyph sprite />
  <Icon sprite />

  <div class="proj-intro" id="projects" data-concept>
    <PageIntro
      layout="split"
      note="Projects"
      title="What we’re building"
      lede="One project is live. Many more can start with you."
    >
      <ProjectIndex slot="figure" />
    </PageIntro>
  </div>

  <ChapterOpener />

  <section
    class="band band--orbit proj-hbs"
    id="hbs"
    data-concept
    aria-labelledby="hbs-title"
  >
    <div class="section-shell">
      <div class="proj-head proj-head--split">
        <div>
          <p class="proj-kicker">Purpose</p>
          <h3 class="h3-section" id="hbs-title">
            Why hemoglobin&nbsp;S makes the mission tangible
          </h3>
        </div>
        <p class="proj-lede">
          One copy can protect against severe malaria; two cause sickle-cell
          disease. Its frequency traces biology, environment and history.
        </p>
      </div>
      <HbsThresholdMap />
    </div>
  </section>

  <section
    class="band proj-apps"
    id="applications"
    data-concept
    aria-labelledby="applications-title"
    data-motion-surface
  >
    <div class="section-shell proj-apps__layout">
      <h3 class="h3-section proj-apps__title" id="applications-title">
        From scattered evidence to better decisions.
      </h3>
      <a
        class="github-cta proj-apps__cta"
        href={`${GITHUB_REPOSITORY}/discussions/1`}
        target="_blank"
        rel="noopener noreferrer"
        ><span>Help shape it</span><strong>Suggest an application</strong><span
          aria-hidden="true">↗</span
        ></a
      >
      <figure
        class="apps proj-apps__figure"
        data-graphic="applications"
        data-kind="mechanism"
      >
        <figcaption class="apps__rule" data-figure-chrome>
          Population evidence is context, not a diagnosis.
        </figcaption>
        <div
          class="apps__grid"
          data-figure-stage
          role="group"
          aria-labelledby="applications-title"
        >
          {
            APPLICATIONS.map((application, index) => (
              <ApplicationCard
                index={index}
                glyph={(index + 1) as 1 | 2 | 3 | 4 | 5 | 6}
                level={4}
                {...application}
              />
            ))
          }
        </div>
      </figure>
    </div>
  </section>

  <section
    class="band band--orbit proj-joinup"
    id="join-up"
    data-concept
    aria-labelledby="join-up-title"
  >
    <div class="section-shell">
      <div class="proj-head">
        <p class="proj-kicker">Process</p>
        <h3 class="h3-section" id="join-up-title">
          From scattered tables to placed evidence
        </h3>
      </div>
      <JoinUp />
    </div>
  </section>

  <section
    class="band proj-counts"
    id="counts"
    data-concept
    aria-labelledby="counts-title"
  >
    <div class="section-shell layout-figure-split">
      <div class="layout-figure-split__text proj-counts__text">
        <h3 class="h3-section" id="counts-title">Counts, not guesses.</h3>
      </div>
      <div class="layout-figure-split__figure">
        <CountsFigure />
      </div>
    </div>
  </section>

  <section
    class="band band--orbit proj-pipeline"
    id="pipeline"
    data-concept
    aria-labelledby="pipeline-title"
  >
    <div class="section-shell">
      <h3 class="h3-section proj-pipeline__title" id="pipeline-title">
        From evidence to an explorable map
      </h3>
      <Pipeline mode={6} stageBrackets={false} idPrefix="project-pipeline" />
    </div>
  </section>

  <section
    class="band proj-safeguards"
    id="safeguards"
    data-concept
    aria-labelledby="safeguards-title"
  >
    <div class="section-shell">
      <figure class="sg" data-graphic="safeguards" data-safeguards>
        <figcaption>
          <h3 class="h3-section" id="safeguards-title">
            Six rules the interface cannot hide
          </h3>
        </figcaption>
        <svg class="sg-defs" aria-hidden="true" focusable="false">
          <defs>
            <pattern
              id="sg-hatch"
              width="5"
              height="5"
              patternUnits="userSpaceOnUse"
              patternTransform="rotate(45)"
            >
              <rect class="sg-hatch-ground" width="5" height="5"></rect>
              <path class="sg-hatch-stroke" d="M2.5 0V5"></path>
            </pattern>
          </defs>
        </svg>
        <div
          class="sg-stage"
          data-figure-stage
          role="group"
          aria-labelledby="safeguards-title"
        >
          <ol class="sg-grid">
            {
              SAFEGUARDS.map((rule, index) => (
                <SafeguardTile
                  rule={(index + 1) as 1 | 2 | 3 | 4 | 5 | 6}
                  title={rule.title}
                  line={rule.line}
                />
              ))
            }
          </ol>
        </div>
      </figure>
      <a class="proj-more" href={sitePath('/docs/scientific-safeguards/')}
        >Safeguards in Docs<Icon name="arrow" size={18} /></a
      >
    </div>
  </section>

  <section
    class="band band--orbit proj-status"
    id="status"
    data-concept
    aria-labelledby="status-title"
  >
    <div class="section-shell">
      <div class="proj-head">
        <p class="proj-kicker">Status</p>
        <h3 class="h3-section" id="status-title">
          What exists—and what comes later
        </h3>
      </div>
      <StatusRail titleId="status-title" />
    </div>
  </section>

  <section class="band proj-follow" aria-labelledby="follow-title">
    <div class="section-shell">
      <h2 class="proj-h2" id="follow-title">Follow the work</h2>
      <ul class="proj-links">
        {
          LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                <Icon name={link.icon} />
                <span>{link.label}</span>
                {link.external && (
                  <Icon name="external" size={18} class="proj-links__out" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</SiteLayout>

<script>
  /*
   * The page's one island (site redesign spec §2.7, §4.2; round 2 spec §4.2; #454): every Projects
   * figure starts here, so the page ships one module instead of one per figure. The HbS map's data
   * load only once that figure is near view.
   */
  import { initCounts } from '../components/project/counts';
  import { initGenotype } from '../components/project/genotype';
  import { initHbsMap } from '../components/project/hbs-map';
  import { initJoinUp } from '../components/project/join-up';
  import { FigureController, prefersReducedMotion } from '../graphics/figure';

  const once = (selector: string, init: (element: HTMLElement) => void) => {
    for (const element of document.querySelectorAll<HTMLElement>(selector)) {
      if (element.hasAttribute('data-island')) continue;
      element.toggleAttribute('data-island', true);
      init(element);
    }
  };

  /** Play a CSS-keyed entrance once (projects.css: is-armed, then is-playing). */
  const cssEntrance = (figure: HTMLElement, duration: number) =>
    new FigureController(figure, {
      duration,
      arm: () => figure.classList.add('is-armed'),
      start: () => {
        figure.classList.remove('is-armed');
        figure.classList.add('is-playing');
      },
      rest: () => figure.classList.remove('is-armed', 'is-playing'),
    });

  once('[data-joinup]', initJoinUp);
  once('[data-genotype-root]', initGenotype);
  once('figure[data-graphic="counts"]', initCounts);

  // The application glyphs draw in once, 90 ms apart (CSS keyed on data-figure-state,
  // applications.css); each replays its mechanism on hover.
  once(
    'figure[data-graphic="applications"]',
    (figure) => new FigureController(figure, { duration: 1100, rest() {} }),
  );

  // The HbS map (hbs-map.ts) and its two data files, once it is within 600 px of view.
  const urls = import.meta.glob(
    ['../data/figures/hbs-region.*.bin', '../data/figures/hbs-surveys.*.bin'],
    { query: '?url', import: 'default', eager: true },
  ) as Record<string, string>;
  const pick = (prefix: string) =>
    Object.entries(urls).find(([file]) => file.includes(`/${prefix}.`))?.[1];
  once('figure[data-graphic="hbs-threshold"]', (figure) => {
    const region = pick('hbs-region');
    const surveys = pick('hbs-surveys');
    if (!region || !surveys) return;
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        near.disconnect();
        void initHbsMap(figure, { region, surveys });
      },
      { rootMargin: '600px 0px' },
    );
    near.observe(figure);
  });

  // The six safeguards (spec §4.2, safeguards): CSS plays them once, 120 ms apart; hovering one replays it.
  const TILE_MS = 1600;
  once('[data-safeguards]', (figure) => {
    const tiles = [...figure.querySelectorAll<HTMLElement>('.sg-tile')];
    cssEntrance(figure, TILE_MS + (tiles.length - 1) * 120);
    for (const tile of tiles) {
      let timer = 0;
      tile.addEventListener('pointerenter', () => {
        if (prefersReducedMotion() || figure.dataset.figureState !== 'rest')
          return;
        tile.classList.remove('is-replaying');
        void tile.offsetWidth;
        tile.classList.add('is-replaying');
        window.clearTimeout(timer);
        timer = window.setTimeout(
          () => tile.classList.remove('is-replaying'),
          TILE_MS,
        );
      });
    }
  });

  // The status rail (spec §4.2, status): it draws once; an item and its node light each other. A
  // tap has no hover to end it, so a tapped pair stays lit until the next tap.
  once('[data-rail]', (figure) => {
    const marks = figure.querySelectorAll<HTMLElement>(
      '[data-item],[data-node]',
    );
    const key = (element: HTMLElement) =>
      element.dataset.item ?? element.dataset.node;
    const light = (lit?: string) => {
      for (const mark of marks)
        mark.classList.toggle('is-lit', !!lit && key(mark) === lit);
    };
    figure.addEventListener('pointerover', (event) => {
      const mark = (event.target as Element).closest<HTMLElement>(
        '[data-item],[data-node]',
      );
      if (mark) light(key(mark));
    });
    figure.addEventListener('pointerout', (event) => {
      if (event.pointerType !== 'touch') light();
    });
    cssEntrance(figure, 1100);
  });
</script>
