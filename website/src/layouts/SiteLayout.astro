---
import Analytics from '../components/Analytics.astro';
import CookieControl from '../components/CookieControl.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MotionController from '../components/MotionController.astro';
import { FAVICON_SVG, rasterIconLinks } from '../lib/favicons';
import { sitePath } from '../lib/paths';
import '../styles/global.css';
import '../styles/pages.css';

interface Props {
  title: string;
  description: string;
  imageAlt?: string;
  viewportFit?: 'cover';
  htmlClass?: string;
}

const {
  title,
  description,
  imageAlt = 'genomeOS, a worldwide atlas of human genetic variation',
  viewportFit,
  htmlClass,
} = Astro.props;
const viewport = [
  'width=device-width',
  'initial-scale=1',
  ...(viewportFit ? [`viewport-fit=${viewportFit}`] : []),
].join(', ');
const fullTitle = title === 'genomeOS' ? title : `${title} | genomeOS`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(
  sitePath('/images/genomeos-banner.png'),
  Astro.site ?? Astro.url.origin,
);
---

<!doctype html>
<html lang="en" class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={viewport} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath(FAVICON_SVG)} />
    {rasterIconLinks().map((link) => <link {...link} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="genomeOS" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <MotionController />
    <CookieControl />
  </body>
</html>
